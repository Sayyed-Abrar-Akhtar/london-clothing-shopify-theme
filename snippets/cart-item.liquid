<section data-contains="cart-items" class="flex space-x-2 items-center min-h-[120px]">
  <section class="w-[15%] min-h-[120px]">
    {{
      item.featured_image.url
      | image_url: width: 54
      | image_tag: alt: item.title, loading: 'lazy', width: 54, height: 80, sizes: sizes, widths: '54, 74, 94'
    }}
  </section>
  <section class="grid grid-rows-3 grid-cols-1 gap-1 justify-between w-[60%] min-h-[120px]">
    <a href="{{ product_url }}" class="text-sm">
      <strong>
        {{ item.title | split: '-' | first }}
      </strong>
    </a>
    <p>
      {{ item.title | split: '-' | last }}
    </p>
    <div class="flex items-center justify-center border-2 border-black">
      <div
        data-btn-type="reduce-quantity"
        class="flex items-center w-3 h-3 cursor-pointer mx-1 md:mx-4 disabled:cursor-not-allowed disabled:bg-slate-400"
      >
        {% render 'icon-minus' %}
      </div>
      <span class="border-x-2 border-black w-5 md:w-12">{{ item.quantity }}</span>
      <div data-btn-type="reduce-quantity" class="flex items-center w-3 h-3 cursor-pointer mx-1 md:mx-4">
        {% render 'icon-plus' %}
      </div>
    </div>
  </section>
  <section class="flex flex-col items-center justify-center w-[25%] min-h-[120px]">
    <span class="w-5 h-5 fill-red-600 flex-grow-1 cursor-pointer">{%- render 'icon-remove' -%}</span>
    <span class="flex-grow-1 block">{{ item.price }}</span>
  </section>
</section>
