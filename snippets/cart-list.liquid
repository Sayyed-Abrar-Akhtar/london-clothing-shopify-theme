<div
  class="s-cart-item flex gap-4 md:gap-8 text-[9px] uppercase tracking-widest w-full justify-between"
  data-cart-item-key="{{ item.key }}"
>
  <div class="flex flex gap-4 md:gap-8">
    <div class="hidden md:!block">
      {{ item.image | image_url: width: 110 | image_tag: width: 110, alt: title }}
    </div>
    <div class="flex flex-col py-3 min-w-[250px] justify-between gap-2">
      <a href="{{ item.product.url }}?variant={{ item.variant_id }}">
        <h2 class="font-bold">{{ item.product.title }}</h2>
      </a>
      <p>{{ item.price | money_with_currency }}</p>
      <p>
        <span>size:</span><span>{{ item.variant.option2 }}</span>
      </p>
      <p>
        <span>Colour:</span><span>{{ item.variant.option1 }}</span>
      </p>
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-2">
          <button
            class="s-cart-item-decrease s-cart-btn"
            style="width:15px;"
            data-key="{{ item.key }}"
            data-quantity="{{ item.quantity }}"
            {% if item.quantity == 0 %}
              disabled
            {% endif %}
          >
            <svg id="Account--Streamline-Atlas" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 50 50">
              <!-- Generator: Adobe Illustrator 30.1.0, SVG Export Plug-In . SVG Version: 2.1.1 Build 136)  -->
              <defs>
                <style>
                  .st0 {
                    fill: none;
                    stroke: #000;
                    stroke-miterlimit: 10;
                    stroke-width: 1.5px;
                  }
                </style>
              </defs>
              <line class="st0" x1="10.4" y1="25" x2="39.6" y2="25"/>
            </svg>
          </button>
          <span class="p-2">{{ item.quantity }}</span>
          <input
            class="col-span-2 border border-gray-300 p-2 w-full hidden"
            type="number"
            name="updates[]"
            id="updates_{{ item.key }}"
            value="{{ item.quantity }}"
            min="0"
            max="{{- item.variant.inventory_quantity -}}"
            aria-label="item quantity"
          >
          <button
            class="s-cart-item-increase s-cart-btn"
            style="width:15px;"
            data-key="{{ item.key }}"
            data-quantity="{{ item.quantity }}"
            data-available-quantity="{{ item.variant.inventory_quantity }}"
            {% if item.quantity == item.variant.inventory_quantity %}
              disabled
            {% endif %}
          >
            <svg id="Account--Streamline-Atlas" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 50 50">
              <!-- Generator: Adobe Illustrator 30.1.0, SVG Export Plug-In . SVG Version: 2.1.1 Build 136)  -->
              <defs>
                <style>
                  .st0 {
                    fill: none;
                    stroke: #000;
                    stroke-miterlimit: 10;
                    stroke-width: 1.5px;
                  }
                </style>
              </defs>
              <line class="st0" x1="25" y1="10.4" x2="25" y2="39.6"/>
              <line class="st0" x1="10.4" y1="25" x2="39.6" y2="25"/>
            </svg>
          </button>
        </div>
        <p class="border-b border-black cursor-pointer s-cart-item-remove" data-key="{{ item.key }}">
          <span role="button">remove</span>
        </p>
      </div>
    </div>
  </div>
  <div class="flex md:items-center justify-end ml-2 my-2 w-24">{{ item.final_line_price | money }}</div>
</div>
