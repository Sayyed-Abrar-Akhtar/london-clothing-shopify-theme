{% assign color_variant = blank %}

{% for color in color_values %}
  {% assign detected_variant = product.variants | find: 'option1', color %}
  {% assign color_variant = color_variant
    | append: detected_variant.id
    | append: '+'
    | append: detected_variant.featured_image.id
    | append: '|'
  %}
{% endfor %}

{% assign color_variant = color_variant | split: '|' %}

