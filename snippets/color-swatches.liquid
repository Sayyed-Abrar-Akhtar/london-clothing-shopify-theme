  {% assign color_link = color_variant[forloop.index] | split: '+' | first %}
  {% assign has_image = color_variant[forloop.index] | split: '+' | last %}


  {% if active_color == color_name %}
    {% if active_color contains 'MUL' %}
      <span
        class="color-swatches color-swatch-multicolor current"
        title="{{ color_name }}"
      >
        &nbsp;
      </span>
    {% else %}
      <span
        class="color-swatches current"
        style="background-color: rgba({{ color_code }},0.5);border-color:rgb({{ color_code }});"
        title="{{ color_name }}"
      >
        &nbsp;
      </span>
    {% endif %}
  {% else %}
    {% if active_color contains 'MUL' %}
      <span
        data-color-swatch-type="link"
        data-color-swatch-link="{{product.url}}?variant={{ color_link }}"
        class="color-swatches color-swatch-multicolor cursor-pointer {% if has_image == blank %}swatch--hidden{% endif %}"
        style="background-color: rgba({{ color_code }},0.8);"
        title="{{ color_name }}"
      >
        &nbsp;
      </span>
    {% else %}
      <span
