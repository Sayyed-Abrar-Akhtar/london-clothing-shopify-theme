              class="product-badge absolute bottom-10 md:bottom-16 left-0 text-[9px] md:text-[11px] font-semibold md:font-normal bg-[rgba(255,255,255,0.75)] text-black px-[8px] py-[5px] uppercase rounded-r"
            >
              {{ badge }}

              {% if product_available
                and product_compare_at_price != blank
                and product_compare_at_price > product_price
                and show_discount_badge
              %}
                <span id="discount-badge-{{ product_id }}" class="text-[11px] text-red-600">
                  {{- product_price | times: 100 | divided_by: product_compare_at_price | minus: 100 }}%</span
                >
              {% endif %}
            </span>
            {% comment %}
              {% render 'card-wishlist-button',
                product_id: product.id,
                variant_id: product.first_available_variant.id,
                product_url: product.url,
                product_title: product_title,
                product_image: image_thumbnail
              %}
            {% endcomment %}
          </section>
          {% comment %}
            {% if product.compare_at_price != blank%}
            <span id='-badge-{{product.id}}' class="discount-badge absolute top-0 right-0  text-xl font-bold text-red-600"></span>
            {% endif %}
          {% endcomment %}

        {% else %}
          <section class="aspect-[291/431] overflow-hidden h-[400px]">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </section>
        {% endif %}
      </div>
      <article class="text-[11px] mt-2" itemscope itemtype="http://schema.org/Product">
        <p class="uppercase font-semibold leading-[19px] tracking-wide space-x-2 max-w-[280px]" itemprop="name">
          {{ product_title }}
        </p>
        <p itemprop="vendor" class="uppercase mt-2">{{ product_vendor }}</p>
        <div class="color-swatches-container flex items-center gap-1 py-1 test-color-swatch">
          {% render 'color-swatches',
            product: product,
            color_values: product.options_by_name.color.values,
            active_color: active_color
          %}
        </div>
        {% comment %} <p class="leading-[19px]">{{ variant.option1 }}</p> {% endcomment %}
        <p class="mb-3 leading-[19px]">
          <data value="{{ product_price | money }}">{{ product_price | money_with_currency }}</data>
          {% if product_compare_at_price != blank and product_compare_at_price > product_price %}
            <!--
              <span class="ml-2 relative before:content-[''] before:absolute before:top-[50%] before:left-0 before:w-full before:h-[1px] before:-rotate-12 before:bg-red-600 before:translate-y-[50%] after:content-[''] after:absolute after:top-[50%] after:left-0 after:w-full after:h-[1px] after:rotate-12 after:bg-red-600 after:translate-y-[50%]">{{ product_compare_at_price | money_with_currency }}</span>
            -->
            <s>
              <data value="{{ product_compare_at_price | money }}">
                {{- product_compare_at_price | money_with_currency -}}
              </data>
            </s>
          {% endif %}
        </p>
      </article>
    </div>
  {% endif %}

  <style>
    [data-cart-drawer-el="open"] {
      z-index:1;
    }
    [data-cart-drawer-el="close"] {
      z-index:100;
    }
    .variant-available-sizes {
      width:100%;
      background-color: #ffffff;
      padding: 10px;
      position: absolute;
      z-index: 1;
      bottom: 0;
      left: 0;
      transition: all 0.5s;
    }
    .variant-available-sizes.variant--hidden{
      visibility: hidden;
      opacity: 0;
    }
    .variant-available-sizes-holder {
      display: flex;
      gap: 2px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .variant-sizes {
      margin: 0;
      font-size: 8px !important;
      font-weight: 500;
      padding:8px;
    }
    .variant-sizes.available:hover {
      text-decoration:underline;
    }
     @media (min-width: 768px) {
      .variant-available-sizes {
        display:none;
        transition: none;
      }
      .product--card:hover .variant-available-sizes{
        display: block;
        visibility: visible;
        opacity:1;
      }
      .variant-sizes {
        margin: 0;
        font-size: 10px !important;
        font-weight: 700;
      }
    }
    .no-stock {
      cursor:default;
      color: #999999;
      text-decoration: line-through;
    }
    .variant-sizes-sold {
      width: 100px;
    }
  </style>

  <script type="application/ld+json">
    {
    "@context": "http://schema.org/",
                                                                                                                                                                                                            "@type": "Product",
                                                                                                                                                                                                            "name": {{ product_title | json }},
    "url": {{ request.origin | append: product_url | json }},
    {% if seo_media -%}
      "image": [
      {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product_description | strip_html | json }},
    "sku": {{ product_sku | json }},
    "brand": {
                                                                                                                                                                                                            "@type": "Brand",                                                        "name": {{ product_vendor | json }}
    },
    "offers": [
    {% if variant == blank or variant == "" %}
      {%- for prod_variant in product.prod_variants -%}
        {
        "@type" : "Offer",
        {%- if prod_variant.sku != blank -%}
          "sku": {{ prod_variant.sku | json }},
        {%- endif -%}
        {%- if prod_variant.barcode.size == 12 -%}
          "gtin12": {{ prod_variant.barcode }},
        {%- endif -%}
        {%- if prod_variant.barcode.size == 13 -%}
          "gtin13": {{ prod_variant.barcode }},
        {%- endif -%}
        {%- if prod_variant.barcode.size == 14 -%}
          "gtin14": {{ prod_variant.barcode }},
        {%- endif -%}
        "availability" : "http://schema.org/{% if prod_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price" : {{ prod_variant.price | divided_by: 100.00 | json }},
        "priceCurrency" : {{ cart.currency.iso_code | json }},
        "url" : {{ request.origin | append: prod_variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {% else %}
      {
      "@type" : "Offer",
      {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
      {%- endif -%}
      {%- if variant.barcode.size == 12 -%}
        "gtin12": {{ variant.barcode }},
      {%- endif -%}
      {%- if variant.barcode.size == 13 -%}
        "gtin13": {{ variant.barcode }},
      {%- endif -%}
      {%- if variant.barcode.size == 14 -%}
        "gtin14": {{ variant.barcode }},
      {%- endif -%}
      "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price" : {{ variant.price | divided_by: 100.00 | json }},
      "priceCurrency" : {{ cart.currency.iso_code | json }},
      "url" : {{ request.origin | append: variant.url | json }}
      }
    {% endif %}
    ]
    }
  </script>
</section>
