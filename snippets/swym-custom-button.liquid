<input
  type="button"
  value="{{ btn_text }}"
  class="swym-button swym-add-to-wishlist mt-2 mb-5 bg-black w-full border-black border-[1px] hover:bg-[#213a70] hover:border-[#213a70] hover:text-white h-[46px] transition delay-75 cursor-pointer"
  data-with-epi="true"
  data-swaction="addToWishlist"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ product.variants[0].id }}"
  data-product-url="{{ shop.url }}{{ product.url }}">

<style>
  input[data-swaction="addToWishlist"].swym-add-to-wishlist {
    color:#fff !important;
  }
  input[data-swaction="addToWishlist"].swym-add-to-wishlist:hover {
    color: #000 !important;
  }
</style>


  