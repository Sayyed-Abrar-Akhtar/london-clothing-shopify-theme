<form>
  <div class="relative w-full grid grid-cols-1 md:grid-cols-5 grid-rows-1 justify-evenly ">
    {%- for filter in collection.filters -%}
      <details
        class="w-full"
        data-type="collection-filters"
        data-open-filter-of="{{ filter.label | downcase | split: ' ' | join: '-' }}"
      >
        <summary class="text-sm font-semibold w-[40%] md:w-[50%] lg:w-full" onclick="showActiveFilter(event)">
          <div class="w-full">
            <span
              data-elem-type="filter-type"
              data-filter-label="{{ filter.label | downcase | split: ' ' | join: '-' }}"
              class="w-full block uppercase"
            >
              {{- filter.label }}&nbsp;

              {%- if filter.active_values.size > 0 -%}
                <span>({{ filter.active_values.size }})</span>
              {%- endif -%}
            </span>
          </div>
        </summary>

        <div class="hidden w-[60%] md:ml-0 md:w-[50%] h-full md:h-[110px] py-4 my-auto">
          {%- case filter.type -%}
            {%- when 'boolean', 'list' -%}
              <ul class="absolute w-[60%] md:w-full top-2 md:top-10 left-[40%] md:left-0 grid gap-2 grid-cols-1 md:grid-cols-3 lg:grid-cols-6 grid-rows-auto text-xs h-full md:h-[100px] py-4 overflow-y-scroll">
                {%- for filter_value in filter.values -%}
                  <li class="w-full">
                    <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}" class="w-full text-ellipsis">
                      <input
                        type="checkbox"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value }}"
                        id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                        {% if filter_value.active -%}
                          checked
                        {%- endif %}
                        {% if filter_value.count == 0 and filter_value.active == false -%}
                          disabled
                        {%- endif %}
                      >
                      {{- filter_value.label -}}
                    </label>
                  </li>
                {%- endfor -%}
              </ul>

            {%- when 'price_range' -%}
              <div class="absolute text-xs w-full uppercase top-10 left-0 grid gap-2 grid-cols-6 grid-rows-auto">
                <div class="price-filter-box">
                  <div class="flex gap-2">
                    <span class="price-range-label">
                      {{ cart.currency.symbol }}
                      <label
                        id="filter-label-{{ filter.min_value.param_name }}"
                        for="Filter-{{ filter.min_value.param_name }}"
                      >
                        {% if filter.min_value.value %}
                          {{- filter.min_value.value | money_without_currency | replace: ',', '' -}}
                        {% else %}
                          0
                        {% endif %}
                      </label>
                    </span>
                    <span class="flex items-center justify-center text-4xl" style="width:20%;">&dash;</span>
                    <span class="price-range-label">
                      {{ cart.currency.symbol }}
                      <label
                        id="filter-label-{{ filter.max_value.param_name }}"
                        for="Filter-{{ filter.max_value.param_name }}"
                      >
                        {% if filter.max_value.value %}
                          {{- filter.max_value.value | money_without_currency | replace: ',', '' -}}
                        {% else %}
                          {{ filter.range_max | money_without_currency | replace: ',', '' }}
                        {% endif %}
                      </label>
                    </span>
                  </div>
                  <div class="relative">
                    <input
                      class="price-range-slider"
                      style="left:0;"
                      type="range"
                      name="{{ filter.min_value.param_name }}"
                      id="Filter-{{ filter.min_value.param_name }}"
                      {% if filter.min_value.value -%}
                        value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                      {% else %}
                        value="0"
                      {%- endif -%}
                      min="0"
                      max="{{ filter.range_max | divided_by: 2 | ceil  | money_without_currency | replace: ',', '' }}"
                    >

                    <input
                      class="price-range-slider"
                      style="right:0;"
                      type="range"
                      name="{{ filter.max_value.param_name }}"
                      id="Filter-{{ filter.max_value.param_name }}"
                      {% if filter.max_value.value -%}
                        value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                      {% else %}
                        value="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      {%- endif -%}
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    >
                  </div>
                </div>
              </div>
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}
  </div>

  <div class="flex space-x-4 my-2 justify-start items-center">
    <input
      class="text-sm underline uppercase font-semibold cursor-pointer"
      type="submit"
      value="Apply"
    >

    {%- for filter in collection.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
          <a class="w-max px-2 py-1 bg-slate-300 rounded-md text-xs" href="{{ filter.url_to_remove }}">
            {%- assign min_value = filter.min_value.value | default: 0 -%}
            {%- assign max_value = filter.max_value.value | default: filter.range_max -%}
            {{ min_value | money }} - {{ max_value | money }} X
          </a>
        {%- endif -%}
      {%- else -%}
        {%- for filter_value in filter.active_values -%}
          <a class="w-max px-2 py-1 bg-slate-300 rounded-md text-xs" href="{{ filter_value.url_to_remove }}">
            {{ filter_value.label }} X
          </a>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    <a
      href="{{ collection.url }}"
      class="text-xs text-red-800 uppercase font-semibold border-red-800 rounded-sm border-b-[1px] p-0"
      >Clear all</a
    >
  </div>
</form>

<script>
    const filterElems = Array.prototype.slice.call(document.querySelectorAll('[data-type="collection-filters"]'));

    const filterElemsContainer = Array.prototype.slice.call(document.querySelectorAll('[data-type="collection-filters"] > div'));

    if (filterElems) {
      filterElems.forEach(elem => {
        if (elem.dataset.openFilterOf === 'product-type') {
          elem.children[1].classList.remove('hidden');
          elem.setAttribute('open', 'open');
          elem
            .children[0]
            .children[0]
            .children[0]
            .classList
            .add('underline')
        };
      });

    };


    function showActiveFilter(event) {
      const type = event.target.dataset.filterLabel;

      filterElems.forEach(element => {
        element.removeAttribute("open");
        element
          .children[0]
          .children[0]
          .children[0]
          .classList
          .remove('underline');
      });

      filterElemsContainer.forEach(el => {

  /* console.log(el)
          console.log(event
            .target
            .parentElement
            .parentElement
            .nextElementSibling)*/
        if (el === event
            .target
            .parentElement
            .parentElement
            .nextElementSibling) {

          el.classList.toggle('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      event.target.parentElement.setAttribute('open', 'open');
      if (! event
          .target
          .parentElement
          .parentElement
          .parentElement
            .children[1]
            .classList
            .contains('hidden')) {
        event.target.classList.add('underline');
      } else {
        event.target.classList.remove('underline');
      };
    }

  function updatePriceRange(sliderInputId, labelId) {
    const sliderInputElement = document.getElementById(sliderInputId);
    const alternateSliderInputElement = document.getElementById(sliderInputId.includes('gte')?"Filter-filter.v.price.lte":"Filter-filter.v.price.gte")
    const labelElement = document.getElementById(labelId);
    sliderInputElement?.addEventListener('change', function() {
      if(sliderInputId.includes('gte')) {

        alternateSliderInputElement.min=sliderInputElement.value
      } else {
        alternateSliderInputElement.max=sliderInputElement.value
      };
      labelElement.innerHTML = Number(sliderInputElement.value).toFixed(2);
    })
  }
  window.updatePriceRange = updatePriceRange;
  updatePriceRange("Filter-filter.v.price.gte", "filter-label-filter.v.price.gte");
  updatePriceRange("Filter-filter.v.price.lte", "filter-label-filter.v.price.lte");
</script>
