<div class="announcement overflow-hidden">
  <div
    class="announcement__container grid "
    style="background: {{ bg-color }}; grid-template-columns: repeat({{blocks.size }}, 100%);"
  >
    {% for block in blocks %}
      <div class="announcement__item w-full relative text-center" style="color:{{color }};">
        <p data-type="global-text">{{ block.settings.text }}</p>
        <p data-type="local-text" class="hidden">{{ block.settings.local_text }}</p>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .announcement__item {
    margin: auto;
    padding:8px;
    font-size: 11px;
    line-height: 17px;
    font-weight: 400;
    letter-spacing:1px;
    text-transform:uppercase;
  }

  .translateAnnouncementXFull {
    transform: translateX(-100%);
    animation: 0.5s linear animateAnnouncements;
  }

  @media screen and (max-width: 449px) {
    .announcement {
      margin-top:72px;
    }
    
  }

  @media screen and (max-width: 500px) {
    .announcement__container {
      height:50px;
    }
  }

  @keyframes animateAnnouncements {
    from {
      transform: translateX(0);
      opacity:1;
    }
    15%{
      opacity:0;
    }
    to {
      transform: translateX(-100%);
      visibility: hidden;
      opacity:0;
    }
  }
</style>

<script>
  let announcementDelay = Number("{{slide_delay}}") ;
  // slide -100% x direction
  document.addEventListener('DOMContentLoaded', () => {
    let timeoutTimer = null
    let classTimeoutTimer = null
    function announcementInAction() {
      if (timeoutTimer) {
        //console.log("I cleared existing timeout")
        clearTimeout(timeoutTimer)
      }
      if (classTimeoutTimer) {
        //console.log("I cleared existing timeout")
        clearTimeout(classTimeoutTimer)
      }
      //console.log("announcement slide started")
      const announcementContainer = document.querySelector('.announcement__container')
      const announcementItems = Array.from(document.querySelectorAll('.announcement__item'));
      if (announcementItems.length <= 1) {
        return;
      };

      announcementItems.forEach(item => item.classList.add('translateAnnouncementXFull'));
      classTimeoutTimer = setTimeout(() => {
        announcementContainer.removeChild(announcementItems[0]);
        announcementItems.forEach(item => item.classList.remove('translateAnnouncementXFull'));
      }, 1000)
      timeoutTimer = setTimeout(() => {
        announcementContainer.appendChild(announcementItems[0]);
        announcementInAction();
      }, (announcementDelay * 1000))
    }
    setTimeout(() => {
      announcementInAction()
    }, (announcementDelay * 1000) + 1000);
  });
</script>
