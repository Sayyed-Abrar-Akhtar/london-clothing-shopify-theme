<div
  role="dialog"
  aria-labelledby="dialogTitle"
  aria-describedby="dialog1Desc"
  class="p-3 border-black"
>
  <div class="flex items-start justify-between">
    <div class="flex items-start gap-3">
      <div class="rounded border-2 border-gray-300 p-1.5">
        {{ icon | image_url: width: 35, height: 35 | image_tag: alt: 'Icon' }}
      </div>
      <div class="flex flex-col gap-2">
        <h2 id="dialogTitle" class="uppercase text-sm font-semibold text-gray-800 mt-0.5">{{ shop.name }}</h2>
        <p id="dialogDesc" class="text-xs text-gray-700 font-semibold">{{ info }}</p>
      </div>
    </div>
    <button id="modal-close-btn" class="text-3xl font-semibold p-1.5 -mt-1.5" style="line-height: 65%">&times;</button>
  </div>
  <div class="flex items-center justify-end mt-2">
    <a href="{{ ios }}" target="_blank" rel="noopener noreferrer" class="p-3">
      {{- ios-btn | image_url: width: 156 | image_tag: alt: 'IOS icon' -}}
    </a>
    <a href="{{ android }}" target="_blank" rel="noopener noreferrer" class="p-3">
      {{- android-btn | image_url: width: 156 | image_tag: alt: 'Android icon' -}}
    </a>
  </div>
</div>
