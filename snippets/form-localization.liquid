<section class="form-currency-selector absolute -left-6 p-2 hidden w-[120px]" onmouseleave="handleMouseLeave(event)">
  <section class="border border-gray-500 bg-white p-2 w-full">
    {%- form 'localization' -%}
      <button
        type="submit"
        onclick="handleSelectClick(event)"
        data-device="{{- device -}}"
        class="flex justify-between px-2 py-2 border border-gray-500 w-full text-sm md:text-md"
      >
        <span class="inline-block" data-device="{{- device -}}">{{- localization.country.currency.iso_code -}}</span>
        <span class="inline-block" data-device="{{- device -}}">&#x25BC;</span>
      </button>
      <select
        title="select currency"
        class=" hidden px-2 py-2 border border-gray-500 w-full text-sm md:text-md"
        data-selection="country_code"
        data-device="{{- device -}}"
        name="country_code"
        onchange="handleSubmit(event)"
        value="{{- localization.country.currency.iso_code -}}"
      >
        {%- for country in localization.available_countries -%}
          {% if country.currency.iso_code == 'EUR'
            or country.currency.iso_code == 'USD'
            or country.currency.iso_code == 'CAD'
            or country.currency.iso_code == 'AUD'
            or country.currency.iso_code == 'GBP'
          %}
            <option class="hidden" value="{{- country.iso_code -}}">{{- country.currency.iso_code -}}</option>
          {% endif %}
        {%- endfor -%}
      </select>
    {%- endform -%}

    <div data-element-type="flag-iso-code-box-{{- device -}}" class="overflow-y-scroll h-[200px] my-2 hidden">
      {%- for country in localization.available_countries -%}
        {% if country.currency.iso_code == 'EUR'
          or country.currency.iso_code == 'USD'
          or country.currency.iso_code == 'CAD'
          or country.currency.iso_code == 'AUD'
          or country.currency.iso_code == 'GBP'
        %}
          <div class="flex space-x-2 my-2" onclick="handleCountryClick(event)">
            <span data-country-iso-code="{{- country.iso_code -}}">
              <img
                class="text-xs font-light"
                src="{{- country | image_url: width: 18 -}}"
                alt="{{- country.iso_code -}}"
                srcset="{{- country | image_url: width: 18 -}} 18w"
                width="18"
                height="14"
                loading="lazy"
              >
            </span>
            <span data-country-iso-code="{{- country.iso_code -}}" class="text-xs">
              {{- country.currency.iso_code -}}
            </span>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </section>
</section>

<script>
  



  window.onload = () => {

    const elems = Array
      .prototype
      .slice
      .call(document.querySelectorAll('[data-selection="country_code"]'));
      elems.forEach((elem) => {
        elem.value = '{{localization.country.iso_code }}'
      });
  }

  function handleSelectClick(event) {
    event.preventDefault()

    const deviceType = event.target.dataset.device


    if (deviceType === 'lg') {
     // console.log('lg');
        //console.log(document.querySelector(`[data-element-type="flag-iso-code-box-${deviceType}"]`));
        document
        .querySelector(`[data-element-type="flag-iso-code-box-${deviceType}"]`)
        .classList
        .toggle('hidden');
    }

    if (deviceType === 'mob') {
      //console.log('mob');
        document.querySelector(`[data-element-type="flag-iso-code-box-${deviceType}"]`).classList.toggle('hidden');
    }
  }

  function handleMouseLeave(event) {
    //console.log('mouseout');
      document
      .querySelector('[data-element-type="flag-iso-code-box-{{-device-}}"]')
      .classList
      .add('hidden');
  }


  function handleCountryClick(event) {
    const elem = document.querySelector('[data-selection="country_code"]')
    elem.value = event
      .target
      .dataset
      .countryIsoCode
      elem
      .dispatchEvent(new Event('change'));
  }

  function handleSubmit(event) {

    document.querySelector(".form-currency-selector > section > form[action='/localization']").submit()

  }

</script>
