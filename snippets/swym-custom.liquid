<script defer>
  let notificationTimeout;
  function handleAddtoWishlistClick(e) {
    //console.log(e.target.dataset)
    let product = {
      epi: Number(e.target.dataset.variantId), // unique variant ID of the product.
      empi: Number(e.target.dataset.productId), // Product ID or master product ID.
      du: e.target.dataset.productUrl // canonical product url.     
    }
    try {
      _swat.addToWishList(product, function(response) {
        //console.log("product successfully added to wishlist", response);
        e.target.classList.add('swym-added');
        e.target.setAttribute("title", "Added");
        showNotificationPopup(e.target.dataset.productTitle, e.target.dataset.productThumbnail);
        notificationTimeout = setTimeout(() => {
          hideNotificationPopup();
        }, 5000);
      }, function(error) {
        //console.log("there was an error adding the product to wishlist", error);
      });
    } catch(error) {
      //console.log(error)
    }
  }


  function fetchListAndCompare() {
    const wishlistIconsElement = Array.prototype.slice.call(document.querySelectorAll('.product-card-wishlist-btn'));
    const nonDuplicatedWishlistElements = wishlistIconsElement.filter((item, index)=> wishlistIconsElement.indexOf(item) === index);
    if(wishlistIconsElement) {
      // Define success callback
      let onSuccess = function(lists) {
        // Successfully fetched all lists 
        const wishlistVariantIds = lists[0].listcontents.map(content=>content.epi);
        //window.wishlistVariantIds= wishlistVariantIds;
        //const productvariantIds = nonDuplicatedWishlistElements.map(item=> item.dataset.variantId);
        //window.productvariantIds = productvariantIds;
        const productsListAddedToWishlist = nonDuplicatedWishlistElements.filter(product=> wishlistVariantIds.indexOf(Number(product.dataset.variantId))>-1 );
        //console.log(productsListAddedToWishlist)
        productsListAddedToWishlist.forEach(element=>{
          element.classList.add('swym-added')
          element.setAttribute("title", "Added")
        });
      }
      
      // Define error callback
      let onError = function(error) {
        // Error is an xhrObject
        //console.log("Error while fetching all Lists", error);
      }
      
      // Call `fetchLists` function
      _swat.fetchLists({
        callbackFn: onSuccess,
        errorFn: onError
      });
    }
  }

  function renderNotification(product) {
    return `
    <div class="swym-notifications-container swymTopLeft">
      <div
        class="swym-notification-wishlist swym-clickable"
        tabindex="0"
        role="button"
      >
        <div class="swym-product-tile">
          <button
            class="swym-close-btn swym-is-button"
            aria-label="Close Notification"
            onclick="handleClose()"
          >
            <span class="swym-icon"></span></button
          ><img
            class="swym-image"
            src="${product.img}"
            alt="${product.name}"
          />
          <div class="swym-details-container">
            <div class="swym-details" role="alert">
              <span class="swym-emphasis"
                >${product.name}</span
              >
              has been added to
              <span class="swym-emphasis">1 list</span> successfully.
            </div>
            <a class="swym-powered-by-text swym-is-anchor"
              href="https://swym.it?utm_medium=notification&amp;utm_source=poweredby"
              target="_blank"
              rel="noreferrer"
              >Powered by SWYM
            </a>
          </div>
        </div>
      </div>
    </div>
    <style>
    .swym-notifications-container.swymTopLeft {
      top: 20px;
      left: 0;
      /* transform: translateX(-300px); */
    }
    .swym-notifications-container.swymTopLeft {
      top: 20px;
      left: 0;
      transform: translateX(0) !important; 
    }
    .swym-notification-wishlist .swym-product-tile {
      background: #fff;
      color: #000;
      padding: 5px;
      display: flex;
      align-items: center;
      position: relative;
    }
    .swym-notification-wishlist .swym-close-btn {
      position: absolute;
      top: 11px;
      right: 10px;
      cursor: pointer;
    }
    .swym-notification-wishlist .swym-image {
      width: 50px;
      flex-shrink: 0;
    }
    .swym-notification-wishlist .swym-details-container {
      display: flex;
      flex-direction: column;
    }
    .swym-notification-wishlist .swym-details {
      padding: 15px 25px 10px 15px;
      font-weight: 500;
      font-size: 12px;
      line-height: 20px;
      letter-spacing: .1em;
      color: #434655;
      word-break: break-word;
    }
    .swym-notification-wishlist .swym-emphasis {
      font-weight: bold;
    }
    .swym-ui-components .swym-icon, .swym-ui-component .swym-icon {
      display: initial;
    }
    .swym-notification-wishlist .swym-close-btn .swym-icon::before {
      content: "";
      font-size: 10px;
    }
    .swym-ui-components .swym-icon::before, .swym-ui-component .swym-icon::before {
        font-family: "swym-font" !important;
        speak: never;
        font-style: normal;
        font-weight: normal;
        font-variant: normal;
        text-transform: none;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    </style>
  `;
  }
  
  function showNotificationPopup(title, img) {
    const notificationContainer = document.querySelector(
      '.swym-wishlist-notifications-container.swym-ui-component'
    );
  
    const element = renderNotification({ name: title, img });
  
    notificationContainer.insertAdjacentHTML('afterbegin', element);
  }
  
  function hideNotificationPopup() {
    const notification = document.querySelector(
      '.swym-wishlist-notifications-container.swym-ui-component > .swym-notifications-container'
    );
  
    if (notificationTimeout) {
      clearTimeout(notificationTimeout);
    }
    notification.remove();
    //console.log('notification popup closed');
  }
  function handleClose() {
    hideNotificationPopup();
  }
  


</script>