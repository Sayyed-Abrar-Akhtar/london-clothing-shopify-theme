{% assign first_img_alt_text = '' %}
{% assign second_img_alt_text = '' %}
{% assign third_img_alt_text = '' %}

<div class="lookbook-container">
  <h1 class="py-6 text-2xl text-center font-bold">{{ section.settings.heading }}</h1>
  {% for block in section.blocks %}
    {% if block.settings.first_image.alt %}
      {% assign first_img_alt_text = block.settings.first_image.alt %}

    {% else %}
      {% assign first_img_alt_text = 'Lookbook 1' %}
    {% endif %}

    {% if block.settings.second_image.alt %}
      {% assign second_img_alt_text = block.settings.second_image.alt %}

    {% else %}
      {% assign second_img_alt_text = 'Lookbook 2' %}
    {% endif %}

    {% if block.settings.third_image.alt %}
      {% assign third_img_alt_text = block.settings.third_image.alt %}

    {% else %}
      {% assign third_img_alt_text = 'Lookbook 3' %}
    {% endif %}
    <div
      class="
        {%- if block.settings.first_image and block.settings.second_image and block.settings.third_image -%}
          three-cols
        {%- elsif block.settings.first_image and block.settings.second_image -%}
          two-cols
        {%- elsif block.settings.first_image and block.settings.third_image -%}
          two-cols
        {%- elsif block.settings.second_image and block.settings.third_image -%}
          two-cols
        {%- else -%}
          one-col
        {%- endif -%}
      "
    >
      {% if block.settings.first_image %}
        {% if block.settings.image_orientation == 'portrait' %}
          {{
            block.settings.first_image
            | image_url: width: 800
            | image_tag: alt: first_img_alt_text, class: 'portrait-img'
          }}
        {% else %}
          {{ block.settings.first_image | image_url: width: 2000 | image_tag: alt: first_img_alt_text }}
        {% endif %}
      {% endif %}
      {% if block.settings.second_image %}
        {% if block.settings.image_orientation == 'portrait' %}
          {{
            block.settings.second_image
            | image_url: width: 800
            | image_tag: alt: second_img_alt_text, class: 'portrait-img'
          }}
        {% else %}
          {{ block.settings.second_image | image_url: width: 2000 | image_tag: alt: second_img_alt_text }}
        {% endif %}
      {% endif %}
      {% if block.settings.third_image %}
        {% if block.settings.image_orientation == 'portrait' %}
          {{
            block.settings.third_image
            | image_url: width: 800
            | image_tag: alt: third_img_alt_text, class: 'portrait-img'
          }}
        {% else %}
          {{ block.settings.third_image | image_url: width: 2000 | image_tag: alt: third_img_alt_text }}
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "styles",
      "name": "Style",
      "settings": [
        {
          "type": "select",
          "id": "image_orientation",
          "label": "Image Orientation",
          "default": "portrait",
          "options": [
            {
              "label": "Landscape",
              "value": "landscape"
            },
            {
              "label": "Portrait",
              "value": "portrait"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "first_image",
          "label": "First Image"
        },
        {
          "type": "image_picker",
          "id": "second_image",
          "label": "Second Image"
        },
        {
          "type": "image_picker",
          "id": "third_image",
          "label": "Third Image"
        }
      ]
    }
  ]
}
{% endschema %}
