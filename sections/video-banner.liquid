{%- liquid
  assign video = section.settings.video
  assign fallback_image = section.settings.fallback_image
  assign mobile_fallback_image = section.settings.mobile_fallback_image | default: fallback_image
  assign heading = section.settings.heading
  assign heading_style = section.settings.heading_style
  assign heading_weight = section.settings.heading_weight
  assign heading_case = section.settings.heading_case
  assign heading_color = section.settings.heading_color
  assign button_text = section.settings.button_text
  assign button_link = section.settings.button_link
  assign url_size = section.settings.url_size
  assign url_style = section.settings.url_style
  assign url_weight = section.settings.url_weight
  assign url_case = section.settings.url_case
  assign url_color = section.settings.url_color
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color = section.settings.overlay_color
  assign disable_on_mobile = section.settings.disable_on_mobile
  assign autoplay = section.settings.autoplay
  assign loop_video = section.settings.loop
  assign mute_video = section.settings.mute
  assign show_controls = section.settings.show_controls
-%}

{% capture caption_styles %}
          background-color:{{ section.settings.background_color }};
          color:heading_color;
        {% endcapture %}

{% capture cta_container_styles %}
          
          {% case section.settings.text_alignment %}
            {% when "left" %}
              justify-content: flex-start;
            {% when "right" %}
              justify-content: flex-end;
            {% else %}
              justify-content: center;
          {% endcase %}
        {% endcapture %}



{% capture heading_styles %}
  color:{{ heading_color }};
  font-size:clamp({{ section.settings.heading_size|times:0.4 }}px, calc({{ section.settings.heading_size |times:0.5}}px + 1vw), {{ section.settings.heading_size |times:1.2}}px);
  font-style:{{ heading_style }};
  font-weight:{{ heading_weight }};
  text-transform:{{ heading_case }};
{% endcapture %}
{% capture cta_styles %}
  color:{{ url_color }};font-size:{{ url_size }}rem;font-style:{{ url_style }};font-weight:{{ url_weight }};text-transform:{{ url_case }};{% if section.settings.is_url_underlined %}border-bottom:1px solid #000000;{% endif %}
{% endcapture %}

{% if section.settings.video %}
  <div class="video-banner-section section-{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="video-banner__container">
      {%- if video != blank -%}
        <div class="video-banner__video {% if disable_on_mobile %}small--hide{% endif %}">
          {{
            video
            | video_tag:
              autoplay: autoplay,
              loop: loop_video,
              muted: mute_video,
              controls: show_controls,
              image_size: '2000x'
          }}
        </div>
      {%- endif -%}

      {%- if fallback_image != blank -%}
        <div class="video-banner__fallback {% if video != blank %}video-banner__fallback--hidden{% endif %}">
          <div
            class="video-banner__image medium-up--show"
            style="background-image: url({{ fallback_image | image_url: '2000x' }});"
          ></div>
          {%- if mobile_fallback_image != blank -%}
            <div
              class="video-banner__image small--show"
              style="background-image: url({{ mobile_fallback_image | image_url: '800x' }});"
            ></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="video-banner__overlay"
        style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};"
      >
        &nbsp;
      </div>
    </div>
    {% if section.settings.caption_location == 'top' %}
      {% render 'image-caption',
        heading_one: section.settings.heading,
        paragraph: section.settings.paragraph,
        cta_label: section.settings.button_text,
        cta_link: section.settings.button_link,
        caption_styles: caption_styles,
        heading_styles: heading_styles,
        paragraph_styles: paragraph_styles,
        cta_container_styles: cta_container_styles,
        cta_styles: cta_styles
      %}
    {% else %}
      {% render 'banner-caption',
        heading_type: 'h1',
        heading: heading,
        cta_label: button_text,
        cta_link: button_link,
        heading_styles: heading_styles,
        cta_styles: cta_styles
      %}
    {% endif %}
  </div>
{% endif %}

<style>
  .video-banner-section {
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
    padding-bottom:10px;
  }
  .video-banner__container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ section.settings.video_height }};
  }
  .video-banner__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .video-banner__video video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-banner__fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .video-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .video-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  @media screen and (max-width: 768px) {
    .video-banner__container {
      padding-bottom: {{ section.settings.mobile_video_height }};
    }
  }
</style>

