<div class="w-full flex justify-center items-center mb-12 md:mb-28">
  {%- for block in section.blocks -%}
    {%- if block.settings.btn_link != blank -%}
    <a href="{{- block.settings.btn_link -}}" style="min-width:{{- block.settings.btn_width -}}px;" class="text-[11px] uppercase mx-4 min-w-[100px] bg-slate-100 text-center rounded-[2px] m-0 leading-[100%] pt-[8px] pb-[10px]">{{- block.settings.btn_text | downcase -}}</a>
    {%- endif -%}
  {%- endfor -%}
  
</div>


{% schema %}
{
  "name": "CTA",
  "tag": "section",
  "blocks": [
    {
      "name": "CTA",
      "type": "cta",
      "settings": [
        {
          "type": "text",
          "label": "Tab Text",
          "id": "btn_text",
          "info": "men",
          "default": "Men"
        },
        {
          "type": "url",
          "label": "Tab Link",
          "id": "btn_link",
          "info": "Collections, menus or pages link."
        },
        {
          "type": "range",
          "label": "Button Width",
          "id": "btn_width",
          "unit": "px",
          "step": 10,
          "min": 20,
          "max": 250,
          "default": 150
        }
      ]
    }
  ],
