<style>
  {{ section.settings.heading_font | font_face }}
</style>
<input type="checkbox" id="hamburger-icon" data-btn-role="toggle-hamburger-menu">
<nav class="nav-smenu" id="hamburgerMenuContainer">
  <div class="nav-smenu--close">
    {% render 'hamburger-icon', type: 'close' %}
  </div>

  <div class="smenu">
    <div class="hamburger-menu">
      <div style="padding-top:50px;">
        <form action="{{ routes.search_url }}" class="relative">
          <div class="relative">
            <input
              style="border-color:black; color:black; font-size:10px;padding-bottom:8px;"
              class="uppercase w-full mx-auto border-b-[1px] font-normal"
              type="text"
              placeholder="Search our store"
              name="q"
              value="{{ search.terms | escape }}"
              id="search-input-hamburger-menu"
            >
          </div>
          <button class="absolute right-0 bottom-[11px]">
            {%- render 'icon-search-thin', class: 'w-[13px] h-[13px]' -%}
          </button>
        </form>
        <ul class="pt-8">
          {%- for link in section.settings.menu.links -%}
            {% render 'hamburger-menu',
              link: link,
              blocks: section.blocks,
              lists-bottom-padding: section.settings['lists-bottom-padding'],
              lists-font-size: section.settings['lists-font-size']
            %}

            {% comment %}
              <li class="smenu-list">
                <span class="smenu-title">{{ link.title }}</span>
                <ul class="smenu-sublist ssublist--hidden">
                  {% for sublink in link.links %}
                    <li class="smenu-subitem {% if sublink.active %}smenu--selected{% endif %}">
                      <a href="{{ sublink.url }}" class="block">{{ sublink.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </li>
            {% endcomment %}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <div class="marketing">
      <div class="marketing--blur">&nbsp;</div>
      {% if section.settings.collection.products.size %}
        <div class="marketing-products">
          <div class="marketing__heading">
            <h2 style="font-size:{{ section.settings.heading_size }}rem; color:{{ section.settings.heading_color }}; font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};">
              {{- section.settings.heading -}}
            </h2>
          </div>
          <div class="marketing-products__container">
            {% for product in section.settings.collection.products %}
              {% render 'card-product',
                product: product,
                variant: '',
                front_image: product.featured_image,
                back_image: product.images[1],
                extraclass: '[&:not(:first-child)]:ml-[15px]',
                data_coll_type: 'FEATURED_PRODUCT',
                show_discount_badge: settings.show_discount_badge,
                show_quickview: false
              %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</nav>

<script>
  function jQueryListToggle(btnSelector = '.smenu-title', sublistSelector = '.smenu-sublist') {
    $(btnSelector).on('click', function (e) {
      if ($(this).hasClass('smenu--selected')) {
        $(this).siblings(sublistSelector).slideToggle(300);
      } else {
        $(sublistSelector).each(function () {
          $(this).css('display', 'none');
        });
        $(this).siblings(sublistSelector).slideToggle(300);
      }
    });

    $(window).on('load', function () {
      if ($(btnSelector).hasClass('smenu--selected')) {
        $(btnSelector + '.smenu--selected')
          .siblings(sublistSelector)
          .css('display', 'block');
      }
    });
  }

  // Wait for jQuery to be available
  if (window.jQuery) {
    jQueryListToggle('.smenu-title', '.smenu-sublist');
    jQueryListToggle('.snestedmenu-title', '.snestedmenu-sublist');
  } else {
    // Fallback if jQuery loads later
    document.addEventListener('DOMContentLoaded', function () {
      if (window.jQuery) {
        jQueryListToggle('.smenu-title', '.smenu-sublist');
        jQueryListToggle('.snestedmenu-title', '.snestedmenu-sublist');
      }
    });
  }
</script>

{% stylesheet %}
