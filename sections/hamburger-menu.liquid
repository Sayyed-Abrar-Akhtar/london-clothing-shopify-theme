{% schema %}
{
  "name": "hamburger-menu",
  "class": "relative",
  "blocks": [
    {
      "type": "Settings",
      "name": "Settings",
      "settings": [
        {
          "type": "textarea",
          "id": "filter",
          "label": "Settings applied to:",
          "info": "Input menu names for which the settings are to be applied. All in lowercase separated by comma."
        },
        {
          "type": "color",
          "id": "text-color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "text-size",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Text Size"
        },
        {
          "type": "range",
          "id": "padding-top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Padding Top"
        },
        {
          "type": "range",
          "id": "padding-right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Padding Right"
        },
        {
          "type": "range",
          "id": "padding-bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Padding Bottom"
        },
        {
          "type": "range",
          "id": "padding-left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Padding Left"
        },
        {
          "type": "font_picker",
          "default": "helvetica_n4",
          "id": "font",
          "label": "Font"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu"
    },
    {
      "type": "range",
      "id": "lists-bottom-padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 33,
      "label": "Lists Bottom Padding"
    },
    {
      "type": "range",
      "id": "lists-font-size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Lists Font Size"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "label": "Heading",
      "id": "heading",
      "default": "You May Like"
    },
    {
      "type": "color",
      "label": "Heading Color",
      "id": "heading_color",
      "default": "#ffffff"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "label": "Heading size",
      "id": "heading_size",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "rem",
      "default": 2
    }
  ]
}
{% endschema %}
