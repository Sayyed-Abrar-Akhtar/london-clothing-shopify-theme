{%- if section.blocks.size > 0 -%}
  {%- assign first_block = section.blocks.first -%}
  {%- if first_block.settings.slide_img -%}
    {{-
      first_block.settings.slide_img
      | image_url: width: 2000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        preload: true,
        widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
        sizes: '100vw',
        style: 'position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;'
    -}}
  {%- endif -%}
  {%- if first_block.settings.slide_img_mobile -%}
    {{-
      first_block.settings.slide_img_mobile
      | image_url: width: 1000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        preload: true,
        widths: '375, 550, 750, 1000, 1500',
        sizes: '100vw',
        style: 'position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;'
    -}}
  {%- endif -%}
{%- endif -%}

<div class="carousel overflow-hidden min-h-[320px] lg:min-h-[320px] relative">
  <div class="carousel__container grid" style="grid-template-columns: repeat(3, 100%);">
    {%- for block in section.blocks -%}
      <div
        class="carousel__item w-full relative"
        {% if block.settings.isImgClickable == true %}
          style="cursor:pointer;"
          data-elem="carousel-elem-container"
          data-link="{{ block.settings.url }}"
          role="link"
        {% endif %}
      >
        <div class="hidden md:!block">
          {% if block.settings.slide_img %}
            {%- if forloop.first -%}
              {{-
                block.settings.slide_img
                | image_url: width: 2000
                | image_tag:
                  alt: block.settings.slide_heading,
                  loading: 'eager',
                  fetchpriority: 'high',
                  preload: true,
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  sizes: '100vw',
                  style: 'width:100%; height:100%; object-fit: cover;'
              -}}
            {%- else -%}
              {{-
                block.settings.slide_img
                | image_url: width: 2000
                | image_tag:
                  alt: block.settings.slide_heading,
                  loading: 'lazy',
                  fetchpriority: 'low',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  sizes: '100vw',
                  style: 'width:100%; height:100%; object-fit: cover;'
              -}}
            {%- endif -%}
          {% endif %}
        </div>
        <div class="block sm:max-h-[600px] overflow-hidden md:hidden">
          {% if block.settings.slide_img_mobile %}
            {%- if forloop.first -%}
              {{-
                block.settings.slide_img_mobile
                | image_url: width: 1000
                | image_tag:
                  alt: block.settings.slide_heading,
                  loading: 'eager',
                  fetchpriority: 'high',
                  preload: true,
                  widths: '375, 550, 750, 1000, 1500',
                  sizes: '100vw',
                  style: 'width:100%; height:100%; object-fit: cover;'
              -}}
            {%- else -%}
              {{-
                block.settings.slide_img_mobile
                | image_url: width: 1000
                | image_tag:
                  alt: block.settings.slide_heading,
                  loading: 'lazy',
                  fetchpriority: 'low',
                  widths: '375, 550, 750, 1000, 1500',
                  sizes: '100vw',
                  style: 'width:100%; height:100%; object-fit: cover;'
              -}}
            {%- endif -%}
          {% endif %}
        </div>

        {% capture caption_styles %}
          background-color:{{ block.settings.background_color }};
          color:{{ block.settings.text_color }};
        {% endcapture %}

        {% capture paragraph_styles %}
          color: {{ block.settings.text_color }};
          font-size: {{ block.settings.text_size }}px;
          margin-bottom: {{ block.settings.paragraph_spacing }}px;
          {% if block.settings.paragraph_font_weight %}
            font-weight: {{ block.settings.paragraph_font_weight }};
          {% endif %}
          {% if block.settings.paragraph_font_style %}
            font-style: {{ block.settings.paragraph_font_style }};
          {% endif %}
          {% if block.settings.paragraph_line_height %}
            line-height: {{ block.settings.paragraph_line_height }};
          {% endif %}
          {% if block.settings.paragraph_letter_spacing %}
            letter-spacing: {{ block.settings.paragraph_letter_spacing }}em;
          {% endif %}
          {% if block.settings.text_alignment %}
            text-align: {{ block.settings.text_alignment }};
          {% endif %}
        {% endcapture %}

        {% capture heading_styles %}
          color:{{ block.settings.heading_color }};
          font-size:clamp({{ block.settings.heading_size|times:0.4 }}px, calc({{ block.settings.heading_size |times:0.5}}px + 1vw), {{ block.settings.heading_size |times:1.2}}px);
          margin-bottom:{{ block.settings.heading_spacing }}px;
          {% if block.settings.heading_font_weight %}
            font-weight: {{ block.settings.heading_font_weight }};
          {% endif %}
          {% if block.settings.heading_font_style %}
            font-style: {{ block.settings.heading_font_style }};
          {% endif %}
          {% if block.settings.heading_letter_spacing %}
            letter-spacing: {{ block.settings.heading_letter_spacing }}em;
          {% endif %}
          {% if block.settings.text_alignment %}
            text-align: {{ block.settings.text_alignment }};
          {% endif %}
        {% endcapture %}

        {% capture cta_styles %}
          background-color:{{ block.settings.button_background }};
          color:{{ block.settings.button_text_color }};
          font-size:{{ block.settings.button_font_size }}px;
          padding:{{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
          border-radius:{{ block.settings.button_border_radius }}px;
          {% if block.settings.text_alignment %}
            text-align: {{ block.settings.text_alignment }};
          {% endif %}
        {% endcapture %}

        {% capture cta_container_styles %}
          
          {% case block.settings.text_alignment %}
            {% when "left" %}
              justify-content: flex-start;
            {% when "right" %}
              justify-content: flex-end;
            {% else %}
              justify-content: center;
          {% endcase %}
        {% endcapture %}

        {% render 'image-caption',
          heading_one: block.settings.heading,
          paragraph: block.settings.paragraph,
          cta_label: block.settings.button_text,
          cta_link: block.settings.button_link,
          caption_styles: caption_styles,
          heading_styles: heading_styles,
          paragraph_styles: paragraph_styles,
          cta_container_styles: cta_container_styles,
          cta_styles: cta_styles
        %}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .carousel {
    margin-bottom: 5rem;
  }

  @media screen and (max-width: 500px) {
    .carousel-button--sm {
      min-width: max-content !important;
      padding: 4px;
      font-size: 14px;
    }
    .carousel {
      margin-bottom: 1.5rem;
    }
  }

  .translateXFull {
    transform: translateX(-100%);
    animation: animateSlider 0.5s;
  }

  @keyframes animateSlider {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
      visibility: hidden;
    }
  }
</style>

{%- style -%}
  .caption-content {
    position: absolute;
    padding: {{ section.settings.padding }}px;
    {% if section.settings.caption_position contains 'center' %}
      left: 50%;
      transform: translateX(-50%);
    {% elsif section.settings.caption_position contains 'right' %}
      right: {{ section.settings.horizontal_offset }}px;
    {% else %}
      left: {{ section.settings.horizontal_offset }}px;
    {% endif %}

    {% if section.settings.caption_position contains 'middle' %}
      top: 50%;
      transform: translateY(-50%);
      {% if section.settings.caption_position contains 'center' %}
        transform: translate(-50%, -50%);
      {% endif %}
    {% elsif section.settings.caption_position contains 'bottom' %}
      bottom: {{ section.settings.vertical_offset }}px;
    {% else %}
      top: {{ section.settings.vertical_offset }}px;
    {% endif %}

    width: {{ section.settings.max_width }}vw;
    border-radius: {{ section.settings.border_radius }}px;
  }
{%- endstyle -%}

<script>
  let slidesDelay = Number('{{section.settings.slide_delay}}');

  document.addEventListener('DOMContentLoaded', () => {
    let timer = null;
    let classTimer = null;

    function carouselInAction() {
      if (timer) {
        clearTimeout(timer);
      }
      if (classTimer) {
        clearTimeout(classTimer);
      }

      const carouselContainer = document.querySelector('.carousel__container');
      const carouselItems = Array.from(document.querySelectorAll('.carousel__item'));
      if (carouselItems.length <= 1) {
        return;
      }

      carouselItems.forEach((item) => item.classList.add('translateXFull'));

      classTimer = setTimeout(() => {
        carouselContainer.removeChild(carouselItems[0]);
        carouselItems.forEach((item) => item.classList.remove('translateXFull'));
      }, 500);

      timer = setTimeout(() => {
        carouselContainer.appendChild(carouselItems[0]);
        carouselInAction();
      }, slidesDelay * 1000);
    }

    setTimeout(() => carouselInAction(), slidesDelay * 1000 + 1000);
  });
</script>

{% javascript %}
  const selectectCarouselElem = Array.from(document.querySelectorAll('[data-elem = "carousel-elem-container"]'));
  if (!selectectCarouselElem) return;

  selectectCarouselElem.forEach(function (elem) {
    const url = elem.dataset.link;
    elem.addEventListener('click', function () {
      window.location.href = url;
    });
  });
{% endjavascript %}

