{% unless request.design_mode %}
  {% unless customer %}
    <script>
      window.location.href = '/account/login';
    </script>
  {% endunless -%}
{% endunless -%}

{%- style -%}
  .confirmation {
    margin-bottom: {{ section.settings.confirmation_margin_bottom }}px;
  }

  .confirmation h1 {
    font-size: {{ section.settings.heading-font-size }}px;
    font-weight: {{ section.settings.heading-weight }};
    margin-top: {{section.settings.heading-mt}}px;
    margin-bottom: {{section.settings.heading-mb}}px;
    padding-top: {{section.settings.heading-pt}}px;
    padding-bottom: {{section.settings.heading-pb}}px;
    color: {{ section.settings.heading-color }};
    text-transform: uppercase;
    letter-spacing: 0.9px;
  }

  .confirmation p {
    font-size: {{ section.settings.paragraph-font-size }}px;
    font-weight: {{ section.settings.paragraph-weight }};
    margin-top: {{section.settings.paragraph-mt}}px;
    margin-bottom: {{section.settings.paragraph-mb}}px;
    padding-top: {{section.settings.paragraph-pt}}px;
    padding-bottom: {{section.settings.paragraph-pb}}px;
    color: {{ section.settings.paragraph-color }};
    text-transform: uppercase;
  }

  .offer {

  }

  .offer h2 {
    font-size: {{ section.settings.offer-font-size }}px;
    font-weight: {{ section.settings.offer-weight }};
    margin-top: {{section.settings.offer-mt}}px;
    margin-bottom: {{section.settings.offer-mb}}px;
    padding-top: {{section.settings.offer-pt}}px;
    padding-bottom: {{section.settings.offer-pb}}px;
    color: {{ section.settings.offer-color }};
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .offer p {
    font-size: {{ section.settings.offer-paragraph-font-size }}px;
    font-weight: {{ section.settings.offer-paragraph-weight }};
    margin-top: {{section.settings.offer-paragraph-mt}}px;
    margin-bottom: {{section.settings.offer-paragraph-mb}}px;
    padding-top: {{section.settings.offer-paragraph-pt}}px;
    padding-bottom: {{section.settings.offer-paragraph-pb}}px;
    color: {{ section.settings.offer-paragraph-color }};
    text-transform: uppercase;
  }

  .offer .promo-code {
    font-size: {{ section.settings.coupon-font-size }}px;
    font-weight: {{ section.settings.coupon-weight }};
    margin-top: {{section.settings.coupon-mt}}px;
    margin-bottom: {{section.settings.coupon-mb}}px;
    padding-block: {{section.settings.coupon-py}}px;
    padding-inline: {{section.settings.coupon-px}}px;
    color: {{ section.settings.coupon-color }};
    background-color: {{ section.settings.coupon-bg-color }};
    text-transform: uppercase;
  }
{%- endstyle -%}

<div
  class="msg-box flex flex-col items-center uppercase"
  data-page="register-success-page"
  data-customer="{{ customer.first_name }}"
>
  {% comment %}
    {{ page.content }}
  {% endcomment %}

  <div class="confirmation">
    {% if section.settings.heading %}
      <h1 class="text-center">{{ section.settings.heading }}, {{ customer.first_name }}!</h1>
    {% endif %}
    {% if section.settings.paragraph %}
      <p class="text-center">{{ section.settings.paragraph }}</p>
    {% endif %}
  </div>

  <div class="offer flex flex-col justify-center items-center">
    {% if section.settings['offer-heading'] %}
      <h2 class="text-center">{{ section.settings['offer-heading'] }}</h2>
    {% endif %}
    {% if section.settings['offer-paragraph'] %}
      <p class="text-center">{{ section.settings['offer-paragraph'] }}</p>
    {% endif %}
    {% if section.settings.coupon %}
      <span class="promo-code text-center">{{ section.settings.coupon }}</span>
    {% endif %}
  </div>
</div>

