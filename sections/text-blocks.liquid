{% if section.blocks.size > 0 %}
  <div
    style="
      width:100%;
      margin:{{ section.settings.top_margin }}px auto {{ section.settings.bottom_margin }}px auto;
      padding:{{ section.settings.top_padding }}px 0 {{ section.settings.bottom_padding }}px 0;
      {% if section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
      {% else %}
      background: {{ section.settings.bg_color }};
      {% endif %}
    "
  >
    {% for block in section.blocks %}
      <style>
        [class^="text-block-paragraph"] {
          max-width : 70%;
          margin: auto;
        }
        .text-block-paragraph{{ section.id }}{{ forloop.index }} {
            font-size: {{ block.settings.text_size }}px;
            border-top: {{ block.settings.border_t }}px solid {{block.settings.border_color}};
            border-bottom: {{ block.settings.border_b }}px solid {{block.settings.border_color}};
            border-right: {{ block.settings.border_r }}px solid {{block.settings.border_color}};
            border-left: {{ block.settings.border_r }}px solid {{block.settings.border_color}};
         }
        @media screen and (max-width:600px) {
          .text-block-paragraph{{ section.id }}{{ forloop.index }} {
            font-size: {{ block.settings.text_size_mob }}px;
          }

          [class^="text-block-paragraph"] {
            max-width : 90%;
            text-align: center;
          }
        }
      </style>
      <p
        class="text-block-paragraph{{ section.id }}{{ forloop.index }}"
        style="
          margin:{{ block.settings.top_margin }}px auto {{ block.settings.bottom_margin }}px auto;
          padding:{{ block.settings.top_padding }}px {{ block.settings.right_padding }}px {{ block.settings.bottom_padding }}px {{ block.settings.left_padding }}px;
          color: {{ block.settings.text_color }};
          font-weight: {{ block.settings.text_font-weight }};
          font-style: {{ block.settings.text_font-style }};
          text-transform: {{ block.settings.text_transform }};
          text-align: {{ block.settings.text_alignment }};
        "
      >
        {{ block.settings.text }}
      </p>
    {% endfor %}
  </div>
{% endif %}

