  function generateDynamicSwatches(link, colors) {
    if (!colors?.length) return '';

    const swatches = colors
      .map((c) => {
        const rgb = colorMap[c.color.toLowerCase()];
        const isColorMulti = c.color.toLowerCase().includes('mul');
        if (!rgb && !isColorMulti) return '';

        return c.current
          ? `<span class="color-swatches ${isColorMulti?'color-swatch-multicolor':''} current" style="background-color: rgba(${rgb},0.5);border-color:rgb(${rgb});" title="${c.color}" aria-label="Current: ${c.color}"><span class="sr-only">${c.color}</span></span>`
          : `<span data-color-swatch-type="link" data-color-swatch-link="${link.replace(
              'variant=',
              `variant=${c.id}`
            )}" class="color-swatches cursor-pointer ${isColorMulti?'color-swatch-multicolor':''} ${
              c.hasImage !== '' ? `` : `swatch--hidden`
            }" style="background-color: rgba(${rgb},0.8);" title="${c.color.toUpperCase()}" aria-label="Select: ${
              c.color
            }" data-color-name="${c.color}" data-variant-id="${c.id}"><span class="sr-only">${c.color}</span></span>`;
      })
      .filter(Boolean)
      .join('');

    return swatches ? `<div class="color-swatches-container flex items-center gap-1 py-1">${swatches}</div>` : '';
  }
  function generateRecentlyViewedCards(
    link,
    title,
    image,
    image_alt,
    back_image,
    back_image_alt,
    price,
    compare_at_price,
    sizes,
    vendor,
    colors
  ) {
    return `
    <div>
      <a href=${link} class="rv-product-card">
        <div class="rv-img-container relative">
          <div class="rv-first-image">
            <img
              src="${image}"
              alt="${image_alt}"
              class="rv-product-image"
              >
            <span id="product-badge-56529492345209" class="product-badge absolute bottom-10 md:bottom-16 left-0 text-[9px] md:text-[11px] font-semibold md:font-normal bg-[rgba(255,255,255,0.75)] text-black px-[8px] py-[5px] uppercase rounded-r">
              new in
            </span>
            <span class="absolute p-6 right-0 text-2xl md:hidden product-card-size-toggle--sm" style="bottom:7px;padding-inline:10px;padding-block:5px;transition:transform 0.7s ease-out;" onclick="showVariantSizes(event, this);" data-sizes="close" data-cart-drawer-el="close">+</span>
          </div>
          <div class="rv-second-image">
            <img
              src="${back_image}"
              alt="${back_image_alt}"
              class="rv-product-image"
              >
            <span id="product-badge-56529492345209" class="product-badge absolute bottom-10 md:bottom-16 left-0 text-[9px] md:text-[11px] font-semibold md:font-normal bg-[rgba(255,255,255,0.75)] text-black px-[8px] py-[5px] uppercase rounded-r">
              new in
            </span>
            <div class="variant-available-sizes" style="display:block;">
              <div class="variant-available-sizes-holder">
                ${
                  sizes.length
                    ? sizes
                        .map(
                          (s) => `
                          <form action="/cart/add" method="post" enctype="multipart/form-data" novalidate="novalidate">
                            ${
                              s.available === 'true'
                                ? `
                                <input type="hidden" name="form_type" value="product">
                                <input type="hidden" name="utf8" value="✓">
                                <input type="hidden" name="id" value="${s.variantId}">
                                <button type="button" name="add" onclick="addVariantToCart(event,this);" class="variant-sizes available variant-${s.variantId}" data-variant="${s.size}" data-variantid="${s.variantId}">
                                  ${s.size}
                                </button>
                              `
                                : `
                                <p class="variant-sizes no-stock variant-${s.variantId}">
                                  ${s.size}
                                </p>
                              `
                            }
                          </form>
                        `
                        )
                        .join('')
                    : ''
                }
                  
              </div>
            </div>
          </div>
        </div>
      </a>
      <div class="rv-product-info">
        <h3 class="uppercase font-semibold leading-[150%] tracking-wide  mb-3 max-w-[280px] text-[11px] tracking-wide">${title}</h3>
        <p class="uppercase tracking-wide  mt-2 max-w-[280px] text-[11px] tracking-wide">${vendor}</p>
        ${generateDynamicSwatches(link, colors)}
        <div class="rv-product-price flex gap-2 items-center text-[11px] tracking-wide">
          ${price}
          ${compare_at_price.length ? compare_at_price : ''}
        </div>
      </div>
    </div>
    `;
  }

  function saveRecentlyViewedItems() {
    const recentlyViewedContainer = document.querySelector('[data-elem-type="recently-viewed-container"]');
    const customerName = recentlyViewedContainer.dataset.customerName;
    const productId = recentlyViewedContainer.dataset.productId;
    const productVendor = recentlyViewedContainer.dataset.productVendor;
    const productColors = recentlyViewedContainer.dataset.productColors;
    const productActiveColor = recentlyViewedContainer.dataset.productActiveColor;
    const productTitle = recentlyViewedContainer.dataset.productTitle;
    const productLink = recentlyViewedContainer.dataset.productLink;
    const productImage = recentlyViewedContainer.dataset.productImage;
    const productImageAlt = recentlyViewedContainer.dataset.productImageAlt;
    const productBackImage = recentlyViewedContainer.dataset.productSecondImage;
    const productBackImageAlt = recentlyViewedContainer.dataset.productSecondImageAlt;
    const productPrice = recentlyViewedContainer.dataset.productPrice;
    const productComparePrice = recentlyViewedContainer.dataset.productComparePrice;
    const productSizes = recentlyViewedContainer.dataset.productSizes;

    const extractedColors = productColors
      .split('|')
      .filter((colorsStr) => colorsStr !== '')
      .map((c) => ({ id: c.split(',')[0], hasImage: c.split(',')[1], color: c.split(',')[2] }))
      .map((ec) => ({
        id: ec.id.replace('id:', '').trim(),
        color: ec.color.replace('color:', '').trim(),
        hasImage: ec.hasImage.replace('hasImage:', '').trim(),
      }));

    const productData = {
      title: productTitle,
      vendor: productVendor,
      link: productLink,
      image: productImage,
      imageAlt: productImageAlt,
      backImage: productBackImage,
      backImageAlt: productBackImageAlt,
      price: productPrice,
      comparePrice: productComparePrice || 0,
      sizes:
        productSizes.split(', ').map((sizeDetail) => ({
          size: sizeDetail.split(':**--**:')[0],
          variantId: sizeDetail.split(':**--**:')[1],
          available: sizeDetail.split(':**--**:')[2],
        })) || [],
      colors: extractedColors.map((ec) => (ec.color === productActiveColor ? { current: true, ...ec } : ec)),
    };
    //console.log(productData);
    //alert(btoa(customerName));
    const items = JSON.parse(localStorage.getItem(customerName)) || [];
    if (items && Object.values(items).length) {
      recentlyViewedContainer.classList.remove('hidden');
      const prodContainer = document.querySelector('.rv-products-container');
      const productCardArr = Object.values(items).map((item) =>
        generateRecentlyViewedCards(
          item.link,
          item.title,
          item.image,
          item.imageAlt,
          item.backImage,
          item.backImageAlt,
          item.price,
          item.comparePrice,
          item.sizes,
          item.vendor,
          item.colors
        )
      );
      prodContainer.innerHTML = productCardArr.join('');
    }
    localStorage.setItem(customerName, JSON.stringify({ ...items, [productId]: productData }));
  }
  saveRecentlyViewedItems();
  document.addEventListener('DOMContentLoaded', function () {
    const productsContainer = document.querySelector('.rv-products-container');
    const wrapper = document.querySelector('.rv-products-wrapper');
    const leftButton = document.querySelector('.rv-nav-btn.rv-left');
    const rightButton = document.querySelector('.rv-nav-btn.rv-right');

    // Function to check if navigation buttons should be visible
    function checkScroll() {
      // Check if content overflows
      if (productsContainer.scrollWidth > productsContainer.clientWidth) {
        wrapper.classList.add('scrollable');
      } else {
        wrapper.classList.remove('scrollable');
      }

      // Show/hide left button
      if (productsContainer.scrollLeft > 0) {
        leftButton.style.opacity = '1';
        leftButton.style.pointerEvents = 'auto';
      } else {
        leftButton.style.opacity = '0';
        leftButton.style.pointerEvents = 'none';
      }

      // Show/hide right button
      if (productsContainer.scrollWidth > productsContainer.clientWidth + productsContainer.scrollLeft) {
        rightButton.style.opacity = '1';
        rightButton.style.pointerEvents = 'auto';
      } else {
        rightButton.style.opacity = '0';
        rightButton.style.pointerEvents = 'none';
      }
    }

    // Event listeners for navigation buttons
    leftButton.addEventListener('click', () => {
      productsContainer.scrollBy({
        left: -300,
        behavior: 'smooth',
      });
    });

    rightButton.addEventListener('click', () => {
      productsContainer.scrollBy({
        left: 300,
        behavior: 'smooth',
      });
    });

    // Update button visibility on scroll
    productsContainer.addEventListener('scroll', checkScroll);

    // Update button visibility on window resize
    window.addEventListener('resize', checkScroll);

    // Initial check
    checkScroll();

    // Add keyboard navigation support
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        leftButton.click();
      } else if (e.key === 'ArrowRight') {
        rightButton.click();
      }
    });
  });
{% endjavascript %}
