{% assign selected_variant = product.selected_or_first_available_variant %}

{% assign selected_product_sizes = '' %}

{% for variant in product.variants %}
  {% if variant.option1 == selected_variant.option1 %}
    {% if selected_product_sizes != blank %}
      {% assign selected_product_sizes = selected_product_sizes
        | append: ', '
        | append: variant.option2
        | append: ':**--**:'
        | append: variant.id
        | append: ':**--**:'
        | append: variant.available
      %}
    {% else %}
      {% assign selected_product_sizes = selected_product_sizes
        | append: variant.option2
        | append: ':**--**:'
        | append: variant.id
        | append: ':**--**:'
        | append: variant.available
      %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign frnt_image = null %}
{% assign bck_image = null %}
{% for image in product.images %}
  {% assign current_image_color = image.alt | split: ',' | last | strip %}

  {% if selected_variant.option1 == current_image_color %}
    {% if frnt_image == blank %}
      {% assign frnt_image = image %}

      {% assign next_image_color = product.images[image.position].alt | split: ',' | last | strip %}
      {% if next_image_color == current_image_color %}
        {% assign bck_image = product.images[image.position] %}
      {% else %}
        {% assign bck_image = frnt_image %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign frnt_image_type = frnt_image.alt | split: ',' | first | strip %}
{% assign frnt_image_color = frnt_image.alt | split: ',' | last | strip %}
{% assign bck_image_type = bck_image.alt | split: ',' | first | strip %}
{% assign bck_image_color = bck_image.alt | split: ',' | last | strip %}

{% capture frnt_image_alternate_text %}
{{frnt_image_type  | replace: 'of a product', '' | replace: 'of product', '' | capitalize }}{% if frnt_image_type contains 'model' %} wearing{% else %} of{% endif %} the {{product.title|capitalize}} in {{frnt_image_color | downcase}}, by brand {{product.vendor|capitalize}}
{% endcapture %}
{% capture bck_image_alternate_text %}
{{bck_image_type  | replace: 'of a product', '' | replace: 'of product', '' | capitalize }}{% if bck_image_type contains 'model' %} wearing{% else %} of{% endif %} the {{product.title|capitalize}} in {{bck_image_color | downcase}}, by brand {{product.vendor|capitalize}}
{% endcapture %}

{% assign frnt_image_alt_text = frnt_image_alternate_text | strip %}
{% assign bck_image_alt_text = bck_image_alternate_text | strip %}

{% assign color_variant = blank %}

{% for color in product.options_by_name.color.values %}
  {% assign detected_variant = product.variants | find: 'option1', color %}
  {% assign color_variant = color_variant
    | append: 'id:'
    | append: detected_variant.id
    | append: ', hasImage:'
    | append: detected_variant.featured_image.id
    | append: ', color:'
    | append: color
    | append: '|'
  %}
{% endfor %}

<div
  class="border-t mb-20 hidden"
  data-product-id="{{ selected_variant.id }}"
  data-product-title="{{ product.title }}"
  data-product-vendor="{{ product.vendor }}"
  data-product-colors="{{ color_variant }}"
  data-product-active-color="{{ selected_variant.option1 }}"
  data-product-link="{{ product.url }}?variant={{ selected_variant.id }}"
  data-product-image="{{ frnt_image.src | image_url: width:800, height:1185 }}"
  data-product-image-alt="{{ frnt_image_alt_text }}"
  data-product-second-image="{{ bck_image.src | image_url: width:800, height:1185 }}"
  data-product-second-image-alt="{{ bck_image_alt_text }}"
  data-product-sizes="{{ selected_product_sizes }}"
  data-product-price="{{ product.price | money_with_currency }}"
  data-product-compare-price="{{ product.compare_at_price | money_with_currency }}"
  data-elem-type="recently-viewed-container"
  data-customer-name="{% if customer!=blank %}{{customer.name}}{% else %}guest{% endif %}"
>
  <div class="recently-viewed-container flex justify-center">
    <div class="rv-container">
      <p
        style="color:#000000;font-size: 23px;font-style:normal;font-weight:bold;"
        class="my-1 md:my-10 uppercase tracking-[2px] text-center"
      >
        {{ section.settings.heading }}
      </p>

      <div class="rv-products-wrapper mx-auto">
        <button class="rv-nav-btn rv-left">
          <span>{% render 'icon-arrow' %}</span>
        </button>

        <div class="rv-products-container gap-[2dvw]">
          <!--
            Product 6
            <a href="/products/6" class="rv-product-card">
              <img
                src="https://london-clothing.com/cdn/shop/files/10_354677ff-b4b1-45e8-ab20-02e91c1d2fa7.jpg?v=1744729916&width=1200"
                alt="Earbuds"
                class="rv-product-image"
                width="50"
                height="100"
              >
              <div class="rv-product-info">
                <h3 class="uppercase font-semibold leading-[150%] tracking-wide space-x-2 mb-3 max-w-[280px] text-[11px] tracking-wide">Noise Cancelling Wireless Earbuds with Case</h3>
                <div class="rv-product-price">$119.99</div>
              </div>
            </a>
          -->
        </div>

        <button class="rv-nav-btn rv-right">
          {% render 'icon-arrow' %}
        </button>
      </div>
    </div>
  </div>
</div>
{% style %}
  .rv-container {
    width: 100%;
    background: white;
    padding-block: 30px;
  }

  .rv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e9ecef;
  }

  .rv-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #2d3748;
  }

  .rv-view-all {
    color: #4a5568;
    text-decoration: none;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rv-view-all:hover {
    color: #2b6cb0;
  }

  .rv-products-wrapper {
    position: relative;
    width:100%;
  }

  .rv-products-container {
    display: flex;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 10px 5px 20px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rv-products-container::-webkit-scrollbar {
    display: none;
  }

  .rv-nav-btn {
    position: absolute;
    top: 50%;
    background: white;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
    color: #4a5568;
    opacity: 0;
    pointer-events: none;
  }

  .rv-products-wrapper.scrollable .rv-nav-btn {
    opacity: 1;
    pointer-events: auto;
  }

  .rv-nav-btn:hover {
    background: #4a5568;
    color: white;
  }

  .rv-nav-btn.rv-left {
    left: -22px;
    transform:rotate(180deg);
  }

  .rv-nav-btn.rv-right {
    right: -22px;
  }

  .rv-product-card {
    flex: 0 0 auto;
    width: 284px;
    aspect-ratio:291/431;
    background: white;
    overflow: hidden;
    transition: transform 0.3s ease;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .rv-product-image {
    width: 100%;
    object-fit: cover;
    border-bottom: 1px solid #e2e8f0;
  }

  .rv-product-info {
    padding-top: 16px;
  }

  .rv-second-image {
    display:none;
    position:absolute;
  }

  .rv-img-container {
    aspect-ratio: 291/431;
  }

  .rv-img-container:hover > .rv-second-image {
    display:block;
  }
  .rv-img-container:hover > .rv-first-image {
    display:none;
  }

  @media (max-width: 768px) {
    .rv-product-card {
      width: 200px;
    }

    .rv-nav-btn {
      width: 40px;
      height: 40px;
    }

    .rv-nav-btn.rv-left {
      left: -15px;
    }

    .rv-nav-btn.rv-right {
      right: -15px;
    }
  }

  @media (max-width: 480px) {
    .rv-container {
      padding: 20px 15px;
    }

    .rv-product-card {
      width: 180px;
    }

    .rv-nav-btn {
      width: 36px;
      height: 36px;
    }
  }
{% endstyle %}

