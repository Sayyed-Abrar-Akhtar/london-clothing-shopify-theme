{% comment %}
  collection-list.liquid
  - Clean, simple collections grid
  - Small text: 11px for secondary info
  - Responsive, minimal styling
{% endcomment %}

{% style %}
  /* Simple & Clean Collections Grid */
  .collection-list-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .collection-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .collection-header h2 {
    font-size: 1.75rem;
    font-weight: 450;
    letter-spacing: -0.3px;
    color: #1a1a1a;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .collection-subtext {
    font-size: 11px;
    color: #6b6b6b;
    border-top: 1px solid #ebebeb;
    display: inline-block;
    padding-top: 0.6rem;
    margin-top: 0.2rem;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.8rem;
  }

  .collection-card {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #eeeeee;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s;
    display: flex;
    flex-direction: column;
  }

  .collection-card:hover {
    border-color: #d0d0d0;
    background-color: #fefefe;
  }

  .card-media {
    aspect-ratio: 4 / 3;
    width: 100%;
    background: #f6f6f6;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .collection-card:hover .card-media img {
    transform: scale(1.02);
  }

  .no-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f4f4;
    color: #aaaaaa;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .card-info {
    padding: 1rem 1rem 1.2rem;
    text-align: left;
  }

  .collection-title {
    font-size: 1rem;
    font-weight: 500;
    color: #141414;
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  /* 11px small text for description and meta */
  .collection-description {
    font-size: 11px;
    color: #6b6b6b;
    line-height: 1.45;
    margin: 0.45rem 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .products-count {
    font-size: 11px;
    color: #8a8a8a;
    display: flex;
    align-items: center;
    gap: 5px;
    border-top: 1px solid #f0f0f0;
    padding-top: 0.7rem;
    margin-top: 0.2rem;
  }

  .products-count strong {
    font-weight: 500;
    color: #3d3d3d;
  }

  .shop-micro-link {
    font-size: 11px;
    font-weight: 500;
    color: #2c2c2c;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 0.65rem;
    border-bottom: 1px dotted #ccc;
    transition: color 0.2s;
  }

  .shop-micro-link:hover {
    color: #000;
    border-bottom-color: #777;
  }

  /* Empty state */
  .empty-collections {
    text-align: center;
    padding: 4rem 1.5rem;
    background: #fafafa;
    border-radius: 28px;
    font-size: 11px;
    color: #7a7a7a;
  }

  @media (max-width: 640px) {
    .collection-list-section {
      padding: 1.5rem 1rem 2.5rem;
    }
    .collections-grid {
      gap: 1.2rem;
    }
  }
{% endstyle %}

<div class="collection-list-section">
  <div class="collection-header">
    <h2>{{ section.settings.title | default: 'Shop by Collection' }}</h2>
    {% if section.settings.subtext != blank %}
      <div class="collection-subtext">{{ section.settings.subtext }}</div>
    {% endif %}
  </div>

  {% assign collections_to_show = section.settings.collection_list %}
  {% assign show_empty = section.settings.show_empty_collections %}

  {% if collections_to_show.size > 0 %}
    <div class="collections-grid">
      {% for collection in collections_to_show %}
        {% if collection.all_products_count > 0 or show_empty %}
          <a href="{{ collection.url }}" class="collection-card">
            <div class="card-media">
              {% if collection.image != blank %}
                {{ collection.image | image_url: width: 500 | image_tag:
                  loading: 'lazy',
                  widths: '300,400,500,600',
                  sizes: '(min-width: 1000px) 300px, (min-width: 780px) 280px, 40vw',
                  alt: collection.title | escape
                }}
              {% elsif collection.products.first.featured_image != blank %}
                {{ collection.products.first.featured_image | image_url: width: 500 | image_tag:
                  loading: 'lazy',
                  alt: collection.title | escape
                }}
              
              {% endif %}
            </div>
            <div class="card-info">
              <h3 class="collection-title">{{ collection.title }}</h3>
              {% if collection.description != blank %}
                <div class="collection-description">
                  {{ collection.description | strip_html | truncate: 85 }}
                </div>
              {% endif %}
              <div class="products-count">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.7">
                  <path d="M20 7H4C2.9 7 2 7.9 2 9V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V9C22 7.9 21.1 7 20 7Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  <path d="M16 21V5C16 3.9 15.1 3 14 3H10C8.9 3 8 3.9 8 5V21" stroke="currentColor" stroke-width="1.5" fill="none"/>
                </svg>
                <span><strong>{{ collection.all_products_count }}</strong> </span>
              </div>
              <div class="shop-micro-link">

                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
 
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (small 11px)",
      "default": "Curated selections for every style"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Select collections to display"
    },
    {
      "type": "checkbox",
      "id": "show_empty_collections",
      "label": "Show empty collections",
      "default": false,
      "info": "Display collections with 0 products"
    }
  ],
  "presets": [
    {
      "name": "Simple collection list",
      "category": "Collection"
    }
  ]
}
{% endschema %}