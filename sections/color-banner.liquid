          }
        },
        {
          "type": "button",
          "settings": {
            "btn_text": "Women",
            "icon_position": "aftertext"
          }
        },
        {
          "type": "button",
          "settings": {
            "btn_text": "Kids",
            "icon_position": "aftertext"
          }
        }
      ]
    },
    {
