      "category": "Promotional",
      "settings": {
        "background_color": "#ff6b6b",
        "heading": "Summer",
        "subheading": "Sale"
      },
      "blocks": [
        {
          "type": "button",
          "settings": {
            "btn_text": "Shop Now",
            "icon_position": "aftertext"
          }
        },
        {
          "type": "button",
          "settings": {
            "btn_text": "View Deals",
            "icon_position": "aftertext"
          }
        }
      ]
    },
    {
      "name": "Color Banner - New Collection",
      "category": "Promotional",
      "settings": {
        "background_color": "#4ecdc4",
