    (function() {
      // Ensure DOM is fully loaded
      document.addEventListener('DOMContentLoaded', function() {
          const collectionDescriptionBox = document.querySelector('.collection-description-box');
          const collectionDescriptionToggler = document.querySelector('.collection-description-toggler');

          if (!collectionDescriptionBox || !collectionDescriptionToggler) return;

          // Initialize the state
          collectionDescriptionToggler.dataset.state = 'close';
          collectionDescriptionBox.style.height = "100px";
          collectionDescriptionBox.style.overflow = "hidden";
          collectionDescriptionBox.style.transition = "height 0.3s ease";

          collectionDescriptionToggler.addEventListener('click', function() {
              if (collectionDescriptionToggler.dataset.state === 'close') {
                  collectionDescriptionBox.style.height = (collectionDescriptionBox.scrollHeight-10) + "px";
                  collectionDescriptionToggler.dataset.state = 'open';
              } else {
                  collectionDescriptionBox.style.height = "100px";
                  collectionDescriptionToggler.dataset.state = 'close';
              }
          });
      });
  })();


    document.addEventListener('DOMContentLoaded', function() {

      const filterBtn = document.getElementById('filter_btn');
      const productsParentElement = document.getElementById('{{ collection.handle }}_{{ collection.id }}');
      const mybutton = document.getElementById('myBackToTopBtn');

      // Hide products initially to prevent flash
      if (productsParentElement) {
        productsParentElement.style.opacity = '0';
        productsParentElement.style.visibility = 'hidden';
      }

      let hasShuffled = false;

      function initSort() {
        const sortSelectElement = document.getElementById("collectionSort");
        if (sortSelectElement) {
          sortSelectElement.parentElement.classList.remove('hidden');
          const url = new URL(window.location);
          const sortBy = url.searchParams.get("sort_by");
          sortSelectElement.value = sortBy || "manual";
        }
      }

      function initFilterBtn() {
        if (filterBtn) {
          filterBtn.classList.remove('filter-btn');
          filterBtn.classList.add('filter-btn--show');
        }
      }

      function initShuffle() {
        {% if section.settings.shuffleActive and vendor_size > 1 %}
          if (hasShuffled) return;
          hasShuffled = true;

          if (typeof collectionShuffler !== 'undefined') {
            collectionShuffler('MAIN_COLLECTION', null);
            // Show products after shuffling
            if (productsParentElement) {
              productsParentElement.style.opacity = '1';
              productsParentElement.style.visibility = 'visible';
            }
          } else {
            window.addEventListener('load', function() {
              if (typeof collectionShuffler !== 'undefined' && !hasShuffled) {
                collectionShuffler('MAIN_COLLECTION', null);
                hasShuffled = true;
                // Show products after shuffling
                if (productsParentElement) {
                  productsParentElement.style.opacity = '1';
                  productsParentElement.style.visibility = 'visible';
                }
              }
            });
          }
        {% else %}
          // If no shuffling needed, show products immediately
          if (productsParentElement) {
            productsParentElement.style.opacity = '1';
            productsParentElement.style.visibility = 'visible';
          }
        {% endif %}
      }

      function initBackToTop() {
        if (!mybutton) return;
        let scrollTimeout;

        const handleScroll = () => {
          if (scrollTimeout) return;
          scrollTimeout = setTimeout(() => {
            const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            mybutton.style.display = scrollTop > 2000 ? 'block' : 'none';
            scrollTimeout = null;
          }, 100);
        };

        mybutton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        window.addEventListener('scroll', handleScroll);
      }

      function initAll() {
        initSort();
        initFilterBtn();
        initShuffle();
        initBackToTop();
      }

      initAll();
    });
</script>

<style>
    .back-to-top, .back-to-top:link, .back-to-top:visited {
      font-size: 21px;
      text-align: center;
      width: 40px;
      height: 40px;
      display: none;
      position: fixed;
      bottom: 17vh;
      right: 30px;
      border: 1px solid #000;
      background-color: #fff;
      text-decoration: none;
      cursor: pointer;
      transition: all 4s linear;
      -webkit-transition: all .2s linear;
  }
</style>

{% stylesheet %}
  .collection-description-box {
    overflow: hidden;
    transition: height 0.3s ease;
  }

  .collection-description-toggler {
    cursor: pointer;
    margin-top: 10px;
  }

  .collection-description-toggler svg {
    transition: transform 0.3s ease;
  }

  .collection-description-toggler[data-state="open"] svg {
    transform: rotate(180deg);
  }
  .filter-btn--show {
    visibility:visible;
  }

  .filter-btn {
    visibility:hidden;
  }

  .filter {
    visibility: hidden;
    transform: translateY(-10px);
    z-index:50;
    transition: all 0.1s;
    animation: easeOutFilter;
    backface-visibility: hidden;
  }

  .filter--active {
    visibility: visible;
    z-index: 2;
    transform: translateY(0);
    transition: all 0.5s;
    animation: easeOutFilter;
    backface-visibility: hidden;
  }

  .price-filter-box {
    grid-column:1 / span 2;
    width:80%;
    margin:auto;
  }



  @media(max-width:768px) {
    .price-filter-box {
      grid-column:2 / span 3;
    }
  }

  @media(max-width:500px) {
     .price-filter-box {
        grid-column:2 / span 4;
     }
  }
  .price-range-label{
    border: 1px solid #eee;
    padding: 4px 8px;
    width:40%;
    display: flex;
    align-items: center;
    gap:2px;
  }

  .price-range-slider {
    position:absolute;
    background: transparent;
    height: 28px;
    -webkit-appearance: none;
    margin: 10px 0;
    width: 50.1%;
  }
  .price-range-slider:focus {
    outline: none;
  }
  .price-range-slider::-webkit-slider-runnable-track {
    width: 100%;
    height: 2px;
    cursor: pointer;
    animate: 0.2s;
    box-shadow: 0px 0px 0px #000000;
    background: #000000;
    border-radius: 0px;
    border: 0px solid #010101;
  }
  .price-range-slider::-webkit-slider-thumb {
    box-shadow: 1px 1px 2px #787878;
    border: 1px solid #000000;
    height: 20px;
    width: 20px;
    border-radius: 10px;
    background: #FFFFFF;
    cursor: pointer;
    -webkit-appearance: none;
    margin-top: -9.5px;
  }
  .price-range-slider:focus::-webkit-slider-runnable-track {
    background: #000000;
  }
  .price-range-slider::-moz-range-track {
    width: 100%;
    height: 2px;
    cursor: pointer;
    animate: 0.2s;
    box-shadow: 0px 0px 0px #000000;
    background: #000000;
    border-radius: 0px;
    border: 0px solid #010101;
  }
  .price-range-slider::-moz-range-thumb {
    box-shadow: 1px 1px 2px #787878;
    border: 1px solid #000000;
    height: 20px;
    width: 20px;
    border-radius: 10px;
    background: #FFFFFF;
    cursor: pointer;
  }
  .price-range-slider::-ms-track {
    width: 100%;
    height: 2px;
    cursor: pointer;
    animate: 0.2s;
    background: transparent;
    border-color: transparent;
    color: transparent;
  }
  .price-range-slider::-ms-fill-lower {
    background: #000000;
    border: 0px solid #010101;
    border-radius: 0px;
    box-shadow: 0px 0px 0px #000000;
  }
  .price-range-slider::-ms-fill-upper {
    background: #000000;
    border: 0px solid #010101;
    border-radius: 0px;
    box-shadow: 0px 0px 0px #000000;
  }
  .price-range-slider::-ms-thumb {
    margin-top: 1px;
    box-shadow: 1px 1px 2px #787878;
    border: 1px solid #000000;
    height: 20px;
    width: 20px;
    border-radius: 10px;
    background: #FFFFFF;
    cursor: pointer;
  }
  .price-range-slider:focus::-ms-fill-lower {
    background: #000000;
  }
  .price-range-slider:focus::-ms-fill-upper {
    background: #000000;
  }

  .collections-sort-box{
    display:inline-block;
    /*padding-right:7px;
    border: 1px solid #000;*/
  }


  _::-webkit-full-page-media, _:future, :root .collections-sort-box {
    /*padding:0 8px;*/
  }


  _::-webkit-full-page-media, _:future, :root .collections-sort-box > select{
    height:28px;
    padding:0;
    -webkit-appearance: none;
  }

  .collections-sort-box > select {
    background:transparent;
    width:95px;
    padding:7px;
    font-size: 11px;
  }

  .collections-sort-box  option {
    text-transform:uppercase;
  }

  .collections-sort-box > select:hover > option {
    color:black;
  }

  @media(min-width:768px) {

    .collections-sort-box > select {
      /*padding:6px 14px;*/
      min-width:112px;
    }

    _::-webkit-full-page-media, _:future, :root .collections-sort-box {
      padding:0 10px;
    }

    _::-webkit-full-page-media, _:future, :root .collections-sort-box > select{
      height:28px;
      padding:0;
    }
  }


  @media(min-width:1024px) {
    .collections-sort-box {
      /*padding-right:14px;*/
    }
    .collections-sort-box > select {
      /*padding:9.5px 14px;*/
    }

    _::-webkit-full-page-media, _:future, :root .collections-sort-box {
      padding:0 20px;
    }
    _::-webkit-full-page-media, _:future, :root .collections-sort-box > select{
      height:35px;
      padding:0;
    }
  }

  @keyframes easeOutFilter {
    0% {
      transform: translateY(0);
    } 50% {
      transform: translateY(10px);
    } 100% {
      transform: translateY(0);
    }
  }
{% endstylesheet %}

