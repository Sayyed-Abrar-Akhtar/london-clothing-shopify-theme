{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'vendor-page.css' | asset_url | stylesheet_tag }}
{{ 'loader.css' | asset_url | stylesheet_tag }}
{{ 'sa-filter.css' | asset_url | stylesheet_tag }}

<script src="{{ 'shuffle-collection.js' | asset_url }}" defer></script>

<script src="{{ 'sa-filter.js' | asset_url }}" defer></script>
<script src="{{ 'show-filter.js' | asset_url }}" defer></script>
<script src="{{ 'sort-product.js' | asset_url }}" defer></script>

{% paginate collection.products by section.settings.products_range -%}
  {% assign total_pages_collection = 1 %}
  {% if collection.products_count <= section.settings.products_range %}
    {% assign total_pages_collection = 1 %}
  {% else %}
    {% assign total_pages_collection = collection.products_count
      | divided_by: section.settings.products_range
      | ceil
      | plus: total_pages_collection
    %}
  {% endif %}
  <style>
    .collection-heading-{{- collection.id -}} {
      font-weight: {{ section.settings.heading-font-weight }};
      font-style:{{ section.settings.heading-font-style }};
      font-size: {{ section.settings.heading-size }}px;
      color: {{ section.settings.heading-color }};
      padding-inline: {{ section.settings.heading-px }}px;
      padding-block: {{ section.settings.heading-py }}px;
      margin-top: {{ section.settings.heading-mt }}px;
      margin-bottom: {{ section.settings.heading-mb }}px;
    }
    .sa-collection-filter-title-font {
      font-weight: {{ section.settings.filter-title-font-weight }};
      font-style:{{ section.settings.filter-title-font-style }};
      font-size:{{section.settings.filter-title-size}}px;
      color: {{section.settings.filter-title-color}};

    }
    .sa-collection-filter-headings-font {
      font-weight: {{ section.settings.filter-headings-font-weight }};
      font-style:{{ section.settings.filter-headings-font-style }};
      font-size:{{section.settings.filter-headings-size}}px;
      color:{{section.settings.filter-headings-color}};
    }
    .sa-collection-filter-labels-font {
      font-weight: {{ section.settings.filter-labels-font-weight }};
      font-style:{{ section.settings.filter-labels-font-style }};
      font-size:{{section.settings.filter-labels-size}}px;
      color:{{section.settings.filter-labels-color}};
    }
    .no-products {
      padding: 3px 8px;
      background: #e5e7eb;
      color: #374151;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      margin-inline:auto;
      margin-top: 30px;
      width:max-content;
    }
  </style>

  <section class="flex justify-between items-center my-0 md:my-4 w-full">
    {% render 'breadcrumbs' %}

    <section class="flex items-center gap-2">
      <div class="collections-sort-box hidden text-xs md:text-sm ">
        <select id="collectionSort" aria-label="Sort products by">
          {%- for option in collection.sort_options %}
            <option
              value="{{ option.value }}"
              {%- if option.value == 'sort_by' %}
                selected="selected"
              {%- endif %}
            >
              {{ option.name | upcase | split: ',' | last }}
            </option>
          {% endfor -%}
        </select>
      </div>
      <button
        id="filter_btn"
        class="filter-btn flex items-center justify-center gap-1 uppercase relative p-1 sm:py-1 md:py-1 lg:py-2 md:tracking-[1px] !text-xs sm:!text-xs md:text-sm"
        onclick="saFilterShow(true)"
      >
        <span class="hidden md:!block">filter</span>
        <span class="ml-2">{% render 'icon-filter', width: 14, height: 14 %}</span>
      </button>
    </section>
  </section>

  <section id="saAppliedFilterContainer">
    {% render 'sa-applied-filter', collection: collection %}
  </section>
  <section class="w-full h-0 relative filter" id="filter_container">
    <section class="w-full p-3 absolute top-0 left-0 bg-white border-[1px] border-black">
      {% render 'collection-filter' %}
    </section>
  </section>
  {% render 'sa-filter', collection: collection %}
  {% assign vendor_size = collection.all_vendors | size %}
  {% if vendor_size == 1 %}
    {% if collection.metafields.custom.logo %}
      <div class="flex items-center justify-center my-10">
        {{
          collection.metafields.custom.logo
          | image_url: width: section.settings['logo-width']
          | image_tag: width: section.settings['logo-width'], alt: 'Indeep'
        }}
      </div>
    {% else %}
      {% if collection.description.size > 20 %}
        <section class="flex gap-2 justify-center w-[90%] md:w-[60%] items-center mx-auto my-10 font-bold">
          <div class="collection-description-box flex items-center" style="height: 100px;">
            <h1 class="collection-heading-{{ collection.id }} vendor-heading">{{ collection.all_vendors }}</h1>
            <div>{{ collection.description }}</div>
          </div>
          <button class="collection-description-toggler" data-state="close">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 50 50"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-6 w-6"
            >
              <defs>
                <style>
                  .st0 {
                    fill: none;
                    stroke: #000;
                    stroke-miterlimit: 10;
                    stroke-width: 1.5px;
                  }
                </style>
              </defs>
              <polyline class="st0" points="10.4 20.2 25 29.8 39.6 20.2"/>
            </svg>
          </button>
        </section>
      {% endif %}
    {% endif %}
  {% else %}
    {% if collection.description.size > 20 %}
      <div class="flex gap-2 justify-center w-[90%] md:w-[60%] items-center mx-auto my-10">
        <div class="collection-description-box" style="height: 100px;">
          {{ collection.description }}
        </div>
        <button class="collection-description-toggler" data-state="close">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 50 50"
            stroke-width="1.5"
            stroke="currentColor"
            class="h-6 w-6"
          >
            <defs>
              <style>
                .st0 {
                  fill: none;
                  stroke: #000;
                  stroke-miterlimit: 10;
                  stroke-width: 1.5px;
                }
              </style>
            </defs>
            <polyline class="st0" points="10.4 20.2 25 29.8 39.6 20.2"/>
          </svg>
        </button>
      </div>
    {% endif %}
  {% endif %}

  {% if collection.products_count > 0 %}
    <section
      id="{{ collection.handle }}_{{ collection.id }}"
      data-element="product-list-container"
      data-collection-handle="{{- collection.handle -}}"
      data-current-page="{{ paginate.current_page }}"
      data-pages="{{ total_pages_collection }}"
      class="collection-products-list invisible grid justify-items-center gap-[2dvw] sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 mb-12"
    >
      {% for product in collection.products %}
        {% assign has_negative_stock = false %}
        {% comment %}
          {% for variant in product.variants %}
            {% if variant.inventory_quantity < 0 %}
              {% assign has_negative_stock = true %}
            {% endif %}
          {% endfor %}
        {% endcomment %}

        {% if has_negative_stock == false %}
          {% liquid
            assign front_image = ''
            assign back_image = ''
          %}

          {% assign variant_color = '' %}
          {% for variant in product.variants %}
            {% for image in product.images %}
              {% assign image_color = image.alt | split: ',' | last | strip %}
              {% if variant.option1 == image_color and variant_color != image_color %}
                {% assign variant_color = image_color %}
                {% liquid
                  assign front_image = image.src
                  assign image_position = image.position
                %}
                {% assign current_img_color = product.images[image_position].alt | split: ',' | last | strip %}

                {% if current_img_color == image_color %}
                  {% assign back_image = product.images[image_position].src %}
                {% else %}
                  {% assign back_image = front_image %}
                {% endif %}

                {%-
                  render 'card-product',
                  product: product,
                  front_image: front_image,
                  back_image: back_image,
                  variant: variant,
                  extraclass: 'brand__collection-item collection-page-only',
                  data_coll_type: 'MAIN_COLLECTION',
                  show_discount_badge: settings.show_discount_badge,
                  show_quickview: true,
                  loading: forloop.index0 < 2 ? 'eager' : 'lazy',
                  fetchpriority: forloop.first ? 'high' : 'auto'
                -%}

                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </section>
  {% else %}
    <div class="no-products">
      <p>Coming soon...</p>
    </div>
  {% endif %}
  <!--
    <section class="flex items-center justify-center my-10">
      <button
        id="load-more-btn--{{ collection.handle }}"
        class="border-[1px] border-black px-10 py-2 lowercase hover:bg-black hover:text-white"
      >
        Load more
      </button>
    </section>
  -->

  <button class="back-to-top" id="myBackToTopBtn" onclick="topFunction()">&uarr;</button>
{% endpaginate %}
{% render 'loader', id: 'moreProductsLoader', coll_handle: collection.handle %}

