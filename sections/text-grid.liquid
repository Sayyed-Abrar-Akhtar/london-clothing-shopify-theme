<style>
  .text-grid-heading-{{- section.id -}} {
    font-weight: {{ section.settings.heading-font-weight }};
    font-style:{{ section.settings.heading-font-style }};
    font-size: {{ section.settings.heading-size }}px;
    color: {{ section.settings.heading-color }};
    padding-inline: {{ section.settings.heading-px }}px;
    padding-block: {{ section.settings.heading-py }}px;
    margin-top: {{ section.settings.heading-mt }}px;
    margin-bottom: {{ section.settings.heading-mb }}px;
  }
  .text-grid-container {
    display:grid;
    grid-template-columns:repeat(6, 1fr);
    gap: {{- section.settings.grid-gap -}}px;
  }
  .text-grid-container > a {
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:4px;
  }
  .text-grid-container > a:hover {
    text-decoration: underline;
  }
  @media screen and (max-width:600px) {
    .text-grid-container {
      grid-template-columns:repeat(3, 1fr);
    }
  }
  {% for block in section.blocks %}
    .text-grid-text-{{-block.id-}} {
      font-weight: {{ block.settings.text-font-weight }};
      font-style:{{ block.settings.text-font-style }};
      font-size: {{ block.settings.text-size }}px;
      color: {{ block.settings.text-color }};
      background-color: {{ block.settings.text-bg-color }};
      padding-inline: {{ block.settings.px }}px;
      padding-block: {{ block.settings.py }}px;
    }
  {% endfor %}}
</style>
<div style="padding-inline: {{ section.settings.section-px }}px; padding-block:{{ section.settings.section-py }}px;">
  <h2 class="text-grid-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
  <div class="text-grid-container">
    {% for block in section.blocks %}
      {% if block.settings['category-link'] %}
        <a class="text-grid-text-{{block.id}}" href="{{ block.settings.category-link }}">
          <span class="uppercase">{{ block.settings.text }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

