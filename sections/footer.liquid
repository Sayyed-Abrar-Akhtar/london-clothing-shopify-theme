<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Wait for jQuery to be available
    if (window.jQuery) {
      initFooterAccordion();
    } else {
      // Fallback if jQuery loads later
      document.addEventListener('DOMContentLoaded', initFooterAccordion);
    }

    function initFooterAccordion() {
      $('.accordion.footer-menu h3').click(function () {
        $(this).next('ul').slideToggle();
        $(this).find('.footer-menu-icon').toggleClass('footer__menu--rotate');
      });
    }
  });
</script>
{% render 'footer',
  container_classes: 'main-container-mx main-container-px my-6 md:mt-[80px]',
  shop_description: section.settings.shop_description,
  facebook_link: section.settings.facebook_link,
  instagram_link: section.settings.instagram_link,
  links: section.settings['footer-menu'].links,
  app_heading: 'Get the App',
  app_qr_code: section.settings.app_qr_code,
  app_info_desktop: section.settings.app_info_desktop,
  app_info_mobile: section.settings.app_info_mobile,
  app_store_link: section.settings.app_store_link,
  app_store_image: section.settings.app_store_img,
  play_store_link: section.settings.play_store_link,
  play_store_image: section.settings.play_store_img
%}

{% stylesheet %}
  .footer-menu-icon{
    transition: transform .5s;
  }
  .footer__menu--rotate {
    transform: rotate(180deg);
  }
{% endstylesheet %}

