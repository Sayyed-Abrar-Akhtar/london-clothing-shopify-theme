<div class="one-click-nav-container flex flex-col py-6 gap-4 justify-center items-center">
  {% if section.settings.heading %}
    <p class="text-[11px] uppercase">{{ section.settings.heading }}</p>
  {% endif %}
  <div class="flex items-center justify-center gap-2">
    {% for block in section.blocks %}
      <a class="text-[11px] uppercase px-4 py-2 border hover:bg-black hover:text-white" href="{{ block.settings.url }}">{{ block.settings.text }}</a>
    {% endfor %}
  </div>
  {% if section.settings.extra_info %}
    <p class="text-[9px] font-semibold">{{ section.settings.extra_info }}</p>
  {% endif %}
</div>
{% schema %}
