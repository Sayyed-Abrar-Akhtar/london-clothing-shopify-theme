    {
      "type": "select",
      "id": "heading_type",
      "label": "Heading type",
      "default": "h2",
      "options": [
        {
          "label": "Heading 2",
          "value": "h2"
        },
        {
          "label": "Heading 3",
          "value": "h3"
        },
        {
          "label": "Heading 4",
