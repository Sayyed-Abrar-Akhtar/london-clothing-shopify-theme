      "unit": "px",
      "default": 0,
      "label": "Top Margin"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Bottom Margin"
    },
    {
      "type": "range",
      "id": "text_buttons_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "Gap Between Text and Buttons"
    },
    {
      "type": "range",
      "id": "buttons_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Gap Between Buttons"
    },
    {
      "type": "text",
      "label": "Left Button Text",
      "id": "left-btn-text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "label": "Left Button Link",
      "id": "left-btn-link"
    },
    {
      "type": "text",
      "label": "Right Button Text",
      "id": "right-btn-text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "label": "Right Button Link",
      "id": "right-btn-link"
    },
    {
      "type": "color",
      "id": "bg-color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "spacing-y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Vertical Spacing"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your promotional text here"
        },
        {
          "type": "color",
          "id": "text-color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "text-font-weight",
          "label": "Text Font Weight",
          "options": [
            {
              "label": "Bold",
              "value": "bold"
            },
            {
              "label": "Bolder",
              "value": "bolder"
            },
            {
              "label": "Lighter",
              "value": "lighter"
            },
            {
              "label": "Normal",
              "value": "normal"
            }
          ],
          "default": "normal"
        },
        {
          "type": "select",
          "id": "text-font-style",
          "label": "Text Font Style",
          "options": [
            {
              "label": "Italic",
              "value": "italic"
            },
            {
              "label": "Normal",
              "value": "normal"
            },
            {
              "label": "Oblique",
              "value": "oblique"
            }
          ],
          "default": "normal"
        },
        {
          "type": "range",
          "id": "text-size",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 18,
          "label": "Text Size - Desktop"
        },
        {
          "type": "range",
          "id": "text-size-tablet",
          "min": 12,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 16,
          "label": "Text Size - Tablet"
        },
        {
          "type": "range",
          "id": "text-size-mobile",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14,
          "label": "Text Size - Mobile"
        },
        {
          "type": "range",
          "id": "spacing",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 12,
