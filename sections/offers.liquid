      "unit": "%",
      "default": 60,
      "label": "Button Width - Mobile (when two buttons)"
    },
    {
      "type": "range",
      "id": "btn-width-single",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50,
      "label": "Button Width - Single Button"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
