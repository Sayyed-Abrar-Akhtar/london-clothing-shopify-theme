{% for textblock in section.blocks %}
  <style>
    .offer-{{- textblock.id -}} {
      padding-block: {{ textblock.settings.spacing }}px;
      font-weight: {{ textblock.settings.text-font-weight }};
      font-style: {{ textblock.settings.text-font-style }};
      text-align: {{ textblock.settings.align }};
      font-size: clamp({{ textblock.settings.text-size-mobile }}px, {{ textblock.settings.text-size-tablet }}px, {{ textblock.settings.text-size }}px);
      color: {{ textblock.settings.text-color }};
      line-height: 1.3;
    }

    @media (min-width: 768px) {
      .offer-{{- textblock.id -}} {
        font-size: {{ textblock.settings.text-size-tablet }}px;
      }
    }

    @media (min-width: 1024px) {
      .offer-{{- textblock.id -}} {
        font-size: {{ textblock.settings.text-size }}px;
      }
    }
  </style>
{% endfor %}

<div style="padding-inline:5%; background-color:{{ section.settings.bg-color }}; padding-block:{{ section.settings.spacing-y }}px; margin-top:{{- section.settings.margin-top -}}px; margin-bottom:{{- section.settings.margin-bottom -}}px">
  <div class="flex flex-col items-center" style="gap: {{ section.settings.text_buttons_gap }}px;">
    <!-- Text Content -->
    <div class="w-full px-2 lg:px-4">
      {% for block in section.blocks %}
        <p class="offer-{{- block.id -}}">
          {{ block.settings.text }}
        </p>
      {% endfor %}
    </div>

    <!-- Buttons - Always beneath text -->
    {% if section.settings['left-btn-link'] or section.settings['right-btn-link'] %}
      <div
        class="flex flex-col sm:flex-row items-center justify-center w-full max-w-md lg:max-w-2xl"
        style="gap: {{ section.settings.buttons_gap }}px;"
      >
        {% if section.settings['left-btn-link'] %}
          <a
            href="{{ section.settings.left-btn-link }}"
            style="width:{% if section.settings['right-btn-link'] %}{{- section.settings.btn-width-mobile -}}%{% else %}{{- section.settings.btn-width-single -}}%{% endif %};"
            class="bg-white text-black text-xs lg:text-[13px] px-4 lg:px-6 py-2 lg:py-3 uppercase text-center inline-block hover:opacity-90 transition-opacity duration-200 whitespace-nowrap sm:w-auto"
          >
            {{- section.settings['left-btn-text'] -}}
          </a>
        {% endif %}

        {% if section.settings['right-btn-link'] %}
          <a
            href="{{ section.settings.right-btn-link }}"
            style="width:{% if section.settings['left-btn-link'] %}{{- section.settings.btn-width-mobile -}}%{% else %}{{- section.settings.btn-width-single -}}%{% endif %};"
            class="bg-white text-black text-xs lg:text-[13px] px-4 lg:px-6 py-2 lg:py-3 uppercase text-center inline-block hover:opacity-90 transition-opacity duration-200 whitespace-nowrap sm:w-auto"
          >
            {{- section.settings['right-btn-text'] -}}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
