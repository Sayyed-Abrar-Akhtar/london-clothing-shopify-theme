<section class="w-[95%] sm:w-[90%] md:w-[80%] lg:w-[70%] mx-auto my-32 pb-10">
  <h1 class="tracking-wide text-center my-16 font-semibold text-xs md:text-[18px] md:font-bold uppercase leading-tight">
    {{ section.settings.page_title }}
  </h1>
  <p class="pb-20 px-5">
    {{ section.settings.page_description }}
  </p>
  <nav class="rte">
    <ul class="ul-Brand">
      {% for product_vendor in section.settings.vendorcollection.all_vendors %}
        <li class="li-Brand">
          <a href="/collections/{{ section.settings.filterCollection.handle }}?filter.p.vendor={{ product_vendor | url_for_vendor| split: '='|last }}">
            {{- product_vendor -}}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</section>

{% stylesheet %}
{% endstylesheet %}

{% schema %}
{
  "name": "vendors-page",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title"
    },
    {
      "type": "text",
      "id": "page_description",
      "label": "Page Description"
    },
    {
      "type": "collection",
      "id": "vendorcollection",
      "label": "Vendors Collection"
    },
    {
      "type": "collection",
      "id": "filterCollection",
      "label": "Filter Collection"
    }
  ]
}
{% endschema %}
