<style>
   .login-title-{{- section.id -}} {
     font-weight: {{ section.settings.title_weight }};
     font-style:{{ section.settings.title_style }};
     font-size: {{ section.settings.title_size }}px;
     color: {{ section.settings.title_color }};
     line-height: 150%;
   }
  .login-heading-{{- section.id -}} {
     font-weight: {{ section.settings.heading_weight }};
     font-style:{{ section.settings.heading_style }};
     font-size: {{ section.settings.heading_size }}px;
     color: {{ section.settings.heading_color }};
     line-height: 250%;
   }
  .login-input-labels-{{- section.id -}} {
     font-weight: {{ section.settings.form_label_weight }};
     font-style:{{ section.settings.form_label_style }};
     font-size: {{ section.settings.form_label_size }}px;
     color: {{ section.settings.form_label_color }};
     line-height: 150%;
   }
   .forgot-password-{{- section.id -}} {
     font-weight: {{ section.settings.forgot_pwd_weight }};
     font-style:{{ section.settings.forgot_pwd_style }};
     font-size: {{ section.settings.forgot_pwd_size }}px;
     color: {{ section.settings.forgot_pwd_color }};
     line-height: 150%;
   }
   .form-label-{{- section.id -}} {
     font-weight: {{ section.settings.form_label_weight }};
     font-style:{{ section.settings.form_label_style }};
     font-size: {{ section.settings.form_label_size }}px;
     color: {{ section.settings.form_label_color }};
   }
   .login-btn-{{- section.id -}} {
      border: 1px solid {{section.settings.btn-bg-color}};
      font-weight: {{ section.settings.btn_text_weight }};
      font-size: {{ section.settings.btn_text_size }}px;
      font-style: {{ section.settings.btn_text_style }};
      color: {{ section.settings.btn-color }};
      background-color: {{section.settings.btn-bg-color}};
      border-radius:{{section.settings.btn-border-radius}}px;
      padding-inline:{{section.settings.btn_px}}px;
      padding-block:{{section.settings.btn_py}}px;
   }
   .login-btn-{{- section.id -}}:hover {
      color: {{ section.settings.btn-color-hover }};
      background-color: {{section.settings.btn-bg-color-hover}};
      border-color: {{ section.settings.btn-bg-color-hover }};
   }
   .no-account-{{- section.id -}} {
     font-weight: {{ section.settings.no_account_weight }};
     font-style:{{ section.settings.no_account_style }};
     font-size: {{ section.settings.no_account_size }}px;
     color: {{ section.settings.no_account_color }};
   }
   .signup-link-{{- section.id -}} {
     font-weight: {{ section.settings.sign_up_text_weight }};
     font-style:{{ section.settings.sign_up_text_style }};
     font-size: {{ section.settings.sign_up_text_size }}px;
     color: {{ section.settings.sign_up_text_color }};
   }
</style>

<div
  id="recover_password_container"
  class="hidden flex w-full sm:w-[90%] md:w-[90%] lg:w-[75%] mx-auto my-4 overflow-hidden px-8"
>
  <div class="flex flex-col justify-center w-full md:w-[55%] mx-auto">
    <div class="flex flex-col items-center justify-center md:space-y-6">
      <h2 class="login-title-{{ section.id }} md:mt-6">RESET YOUR PASSWORD</h2>
      <p class="login-heading-{{ section.id }} mt-2 text-center md:text-left">
        We will send you an email to reset your password.
      </p>
    </div>

    {% form 'recover_customer_password' %}
      <ul class="mb-4 text-red-500" style="font-size:9px;letter-spacing:0.5px;font-weight:700;">
        <li>
          {{ form.errors | default_errors }}
        </li>
      </ul>
      <div class="relative my-6">
        <label class="login-input-labels-{{ section.id }} ml-3 inline-block tracking-wide my-2">
          {{- section.settings.email_label }}
        </label>
        <input
          class="w-full px-4 py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
          type="email"
          name="email"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif -%}
          placeholder="{{- section.settings.email_placeholder -}}"
        >
      </div>

      <div>
        <button
          type="submit"
          class="login-btn-{{ section.id }} uppercase w-full flex justify-center tracking-wide cursor-pointer"
        >
          Submit
        </button>
      </div>
    {%- endform -%}
    <div class="my-6">
      <a
        href="{{ routes.account_login_url }}"
        class="login-btn-{{ section.id }} flex justify-center tracking-wide cursor-pointer"
      >
        Go back
      </a>
    </div>
  </div>
</div>

<div
  id="account_login_container"
  class="relative flex w-full sm:w-[90%] md:w-[90%] lg:w-[75%] mx-auto my-4 overflow-hidden"
>
  <div class="flex flex-col items-center sm:justify-center md:justify-start flex-auto min-w-0 bg-white z-1">
    <div class="md:flex md:items-center md:justify-center sm:w-auto md:h-full w-full md:w-[55%] px-8 bg-white">
      <div class="max-w-md w-full">
        <div class="text-center">
          <h2 class="login-title-{{ section.id }} md:mt-6">
            {{ section.settings.title }}
          </h2>
          <p class="login-heading-{{ section.id }} mt-2">
            {{ section.settings.heading }}
          </p>
        </div>
        <div class="flex flex-row justify-center items-center space-x-3"></div>

        <div class="mt-8 space-y-6">
          {% form 'customer_login' %}
            <div class="relative">
              <label class="login-input-labels-{{ section.id }} tracking-wide">
                {{- section.settings.email_label }}
              </label>
              <input
                class=" w-full py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif -%}
                placeholder="{{- section.settings.email_placeholder -}}"
              >
            </div>
            <div class="mt-8 content-center">
              <label class="login-input-labels-{{ section.id }} tracking-wide">
                {{ section.settings.password_label }}
              </label>
              <input
                class="w-full content-center py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="password"
                value=""
                name="customer[password]"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{- section.settings.password_placeholder -}}"
              >
            </div>
            <div class="flex items-center justify-between my-6">
              <div>
                <span
                  href="#recover"
                  onclick="forgotPassword()"
                  class="forgot-password-{{ section.id }} cursor-pointer"
                >
                  {{ section.settings.forgot_password }}
                </span>
              </div>
            </div>
            <div class="my-2 flex justify-center items-center">
              <button
                type="submit"
                class="login-btn-{{ section.id }} flex justify-center uppercase tracking-wide cursor-pointer"
              >
                {{ section.settings.btn_text }}
              </button>
            </div>
          {%- endform -%}
          <p class="flex flex-col items-center justify-center mt-10 text-center sign gap-4">
            <span class="no-account-{{ section.id }}">{{ section.settings.no_account }}</span>
            <a
              href="{{ routes.account_register_url }}"
              class="signup-link-{{ section.id }} no-underline hover:underline cursor-pointer transition ease-in duration-300"
            >
              {{- section.settings.sign_up_text -}}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const forgotPassword = () => {
    location?.href?.includes('#recover') ? null : location.assign(`${location.href}#recover`);
    const recoverContainer = document.getElementById('recover_password_container');
    const loginContainer = document.getElementById('account_login_container');

    recoverContainer.classList.remove('hidden');
    loginContainer.classList.add('hidden');
  };
</script>

