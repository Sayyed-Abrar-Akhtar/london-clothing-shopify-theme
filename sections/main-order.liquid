<section class="my-24 mx-6 md:mx-10 tracking-wider">

  <h1 class="text-2xl md:text-3xl uppercase my-8 font-semibold text-center">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="back-to-account">
    <a href="/account" class="border-b-2 border-black inline-block mb-8 text-md">
      <span>&#8592;</span>&nbsp;{{ 'customer.account.return' | t }}</a>
  </p>
  <div class="flex justify-between flex-col lg:flex-row space-y-6 space-x-0 selection:lg:space-y-0 lg:space-x-4">
    <div class="shadow-md">
      <div class="general-info-order">
        <!--
        <p class="back-to-account"><a href="/account"><span>&#8592;</span>&nbsp;{{ 'customer.account.return' | t }}</a></p>
        -->

        <p class="text-sm md:text-md font-semibold py-3">Order date: {{ order.created_at | date: "%B %d, %Y %I:%M%p" }}</p>

        {% if order.cancelled %}
          {%- assign cancelled_at = order.cancelled_at | date: "%B %d, %Y %I:%M%p" -%}
          <p class="text-2xl py-3">{{ cancelled_at | date: "%B %d, %Y %I:%M%p" }}</p>
          <p text-2xl py-3>{{ order.cancel_reason }}</p>
        {% endif %}
      </div>

      <section class="hidden lg:!block">

        <section class="grid grid-cols-8 grid-rows-1 justify-center items-center text-center bg-[#333333] font-bold capitalize text-white px-2 py-3.5 mb-0">
          <p class="col-span-3">{{ 'customer.order.product' | t }}</p>
          <p class="col-span-2">{{ 'customer.order.sku' | t }}</p>
          <p>{{ 'customer.order.price' | t }}</p>
          <p>{{ 'customer.order.quantity' | t }}</p>
          <p>{{ 'customer.order.total' | t }}</p>
        </section>
        <section class="">
          {% for line_item in order.line_items %}
            <section id="{{ line_item.key }}" class="grid grid-cols-8 grid-rows-1 justify-center items-center text-center mb-0">
              <div data-label="product" class="col-span-3 bg-[#dddddd40] h-full pl-2 py-3">
                <p class="text-left">{{ line_item.title | link_to: line_item.product.url }}
                </p>
              </div>
              <p data-label="sku" class="col-span-2 h-full py-3 flex items-center justify-center bg-[#eeeeee40]">{{ line_item.sku }}</p>
              <p data-label="price" class="bg-[#dddddd40] h-full py-3 flex items-center justify-center">{{ line_item.price | money }}</p>
              <p data-label="quantity" class="h-full  py-3 flex items-center justify-center bg-[#eeeeee40]">{{ line_item.quantity }}</p>
              <p data-label="total" class="bg-[#dddddd40] h-full pr-2  py-3 flex items-center justify-center">{{ line_item.quantity | times: line_item.price | money }}</p>
            </section>
          {% endfor %}
        </section>
        <section class="p-4 bg-[#333333] font-bold capitalize text-white">
          <div class="flex justify-between py-2">
            <p colspan="4" class="">{{ 'customer.order.subtotal' | t }}</p>
            <p data-label="{{ 'customer.order.subtotal' | t }}">{{ order.line_items_subtotal_price | money }} </p>
          </div>



          <div class="flex justify-between py-2">
            <p colspan="4" class="small--hide">{{ 'customer.order.total' | t }}</p>
            <p data-label="{{ 'customer.order.total' | t }}">{{ order.total_price | money }}</p>
          </div>
        </section>
      </section>
      <section class="block lg:hidden mt-6 text-xs md:text-sm">
        {% for line_item in order.line_items %}
          <section id="{{ line_item.key }}" class="[&:not(:first-child)]:pt-3 [&:not(:last-child)]:border-b [&:not(:last-child)]:border-gray-400">
            <div class="flex justify-between items-center bg-[#dddddd40] px-1">
              <p class="col-span-3">{{ 'customer.order.product' | t }}</p>
              <div data-label="product" class="col-span-3 h-full pl-2 py-3">
                <p class="text-left">{{ line_item.title | link_to: line_item.product.url }}
                </p>
              </div>
            </div>
            <div class="flex justify-between items-center bg-[#eeeeee40] px-1">
              <p class="col-span-2">{{ 'customer.order.sku' | t }}</p>

              <p data-label="sku" class="col-span-2 h-full py-3 flex items-center justify-center bg-[#eeeeee40]">{{ line_item.sku }}</p>
            </div>
            <div class="bg-[#dddddd40] flex justify-between items-center px-1">
              <p>{{ 'customer.order.price' | t }}</p>

              <p data-label="price" class="h-full py-3 flex items-center justify-center">{{ line_item.price | money }}</p>
            </div>
            <div class="flex justify-between items-center bg-[#eeeeee40] px-1">
              <p>{{ 'customer.order.quantity' | t }}</p>
              <p data-label="quantity" class="h-full  py-3 flex items-center justify-center">{{ line_item.quantity }}</p>
            </div>
            <div class="flex justify-between items-center bg-[#dddddd40] px-1">
              <p>{{ 'customer.order.total' | t }}</p>
              <p data-label="total" class="h-full pr-2  py-3 flex items-center justify-center">{{ line_item.quantity | times: line_item.price | money }}</p>
            </div>
          </section>
        {% endfor %}
      </section>
    </div>
    <div class="w-full lg:w-[420px] shadow-md flex flex-col md:flex-row lg:flex-col justify-between px-4 py-6 text-sm md:text-md space-y-6 md:space-y-0">
      <div class="order-address-info billing-info">

        <h3 class="text-lg font-semibold uppercase">{{ 'customer.order.billing_address' | t }}</h3>

        <p class="my-3">{{ 'customer.order.payment_status' | t }}:
          <strong>{{ order.financial_status_label }}</strong>
        </p>

        <p>{{ order.billing_address | format_address }}</p>
      </div>
      <div class="order-address-info shipping-info">
        <h3 class="text-lg font-semibold uppercase">{{ 'customer.order.shipping_address' | t }}</h3>

        <p class="my-3">{{ 'customer.order.fulfillment_status' | t }}:
          <strong>{{ order.fulfillment_status_label }}</strong>
        </p>

        <p>{{ order.shipping_address | format_address }}</p>
      </div>
    </div>
  </div>

</section>