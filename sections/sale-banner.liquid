<section class="mb-12 md:mb-28">
  <div class="flex flex-col items-center justify-center bg-sale-banner py-5 min-h-[180px]">
    <h2 class="text-xl leading-[150%] md:text-2xl md:leading-[150%] lg:text-[44px] tracking-[2px] lg:leading-[180%] font-bold text-center uppercase text-white">
      {{- section.settings.heading -}}
    </h2>
    <h4 class="text-lg font-semibold leading-[130%] md:text-xl md:leading-[130%] lg:text-[32px] lg:leading-[150%] text-center inline-block uppercase">
      {{- section.settings.subheading -}}
    </h4>
    <div class="w-full flex justify-center items-center my-5">
      {%- for block in section.blocks -%}
        {%- if block.settings.btn_link != blank -%}
          <a
            href="{{- block.settings.btn_link -}}"
            class="mx-1 min-w-[100px] text-center rounded-[2px] m-0 leading-[100%] pt-[8px] pb-[10px] uppercase text-[14px] tracking-[1px]"
            style="padding-top:10px; min-width:{{- section.settings.btn_width -}}px; color:{{- section.settings.btn_color -}}; background-color:{{- section.settings.btn_bg_color -}}"
          >
            {{- block.settings.btn_text | downcase -}}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .bg-sale-banner {
    background: {{ section.settings.bg-color }};
  }
{% endstyle %}

{% schema %}
