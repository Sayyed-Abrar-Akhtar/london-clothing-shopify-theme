<style>
  {% for block in section.blocks %}
      .promotion-text-{{ block.id }} {
        font-weight: {{ block.settings.text-font-weight }};
        font-style:{{ block.settings.text-font-style }};
        font-size: {{ block.settings.text-size }}px;
        color: {{ block.settings.text-color }};
      }
  {% endfor %}
  .promotion-heading-{{section.id}} {
      font-weight: {{ section.settings.heading-font-weight }};
      font-style:{{ section.settings.heading-font-style }};
      font-size: {{ section.settings.heading-size }}px;
      color: {{ section.settings.heading-color }};
      margin-top: {{ section.settings.heading-mt }}px;
      margin-bottom: {{ section.settings.heading-mb }}px;
      padding-inline: {{ section.settings.heading-px }}px;
      padding-block: {{ section.settings.heading-py }}px;
  }
  .promotion-url-label-{{section.id}} {
      font-weight: {{ section.settings.url_label-font-weight }};
      font-style:{{ section.settings.url_label-font-style }};
      font-size: {{ section.settings.url_label-size }}px;
      color: {{ section.settings.url_label-color }};
      margin-top: {{ section.settings.url_label-mt }}px;
      margin-bottom: {{ section.settings.url_label-mb }}px;
      padding-inline: {{ section.settings.url_label-px }}px;
      padding-block: {{ section.settings.url_label-py }}px;
  }
</style>
<div style="padding-inline: {{ section.settings.section-px }}px; padding-block:{{ section.settings.section-py }}px; background-color:{{ section.settings.bg-color }};">
  <div class="flex flex-col md:flex-row">
    <div class="w-full md:w-1/2 flex items-end">
      <div class="p-6">
        <h2 class="promotion-heading-{{section.id}} uppercase">{{ section.settings.heading }}</h2>
        <a href="{{ routes.account_register_url }} uppercase" class="promotion-url-label-{{section.id}} block">
          <p>{{ section.settings.url_label }}</p>
        </a>
      </div>
    </div>
    <div class="p-6 w-full md:w-1/2">
      <div
        class="p-6 flex flex-col gap-4"
        style="border: {{ section.settings.border-size }}px solid {{ section.settings.border-color }};"
      >
        {% for textblock in section.blocks %}
          <p class="flex gap-6 items-center py-2 uppercase">
            <svg
              fill="{{ textblock.settings.text-color }}"
              version="1.1"
              id="Capa_1"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              width="20px"
              height="20px"
              viewBox="0 0 352.62 352.62"
              xml:space="preserve"
            >
              <g id="SVGRepo_bgCarrier" stroke-width="0"/>

              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"/>

              <g id="SVGRepo_iconCarrier"> <g> <path d="M337.222,22.952c-15.912-8.568-33.66,7.956-44.064,17.748c-23.867,23.256-44.063,50.184-66.708,74.664 c-25.092,26.928-48.348,53.856-74.052,80.173c-14.688,14.688-30.6,30.6-40.392,48.96c-22.032-21.421-41.004-44.677-65.484-63.648 c-17.748-13.464-47.124-23.256-46.512,9.18c1.224,42.229,38.556,87.517,66.096,116.28c11.628,12.24,26.928,25.092,44.676,25.704 c21.42,1.224,43.452-24.48,56.304-38.556c22.645-24.48,41.005-52.021,61.812-77.112c26.928-33.048,54.468-65.485,80.784-99.145 C326.206,96.392,378.226,44.983,337.222,22.952z M26.937,187.581c-0.612,0-1.224,0-2.448,0.611 c-2.448-0.611-4.284-1.224-6.732-2.448l0,0C19.593,184.52,22.653,185.132,26.937,187.581z"/> </g> </g>
            </svg>
            <span class="promotion-text-{{ textblock.id }}">
              {{ textblock.settings.text }}
            </span>
          </p>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

