<style>
  .newsletter-container{
    height :{{section.settings.sm-image-height}}px;
    background:center / cover no-repeat url('{{ section.settings.bg-image | image_url}}');
    margin-block:{{section.settings.my}}px;
    margin-inline:{{settings.uniform-mx-sm}}px;
  }
  .newsletter-styles{
    height:100%;
    margin-block:40px;
    display:flex;
    justify-content:{{section.settings.x-alignment}};
    align-items:{{section.settings.y-alignment}};
    margin-inline:19px;
    padding-block:{{section.settings.py}}px;
    padding-inline:{{section.settings.px}}px;
  }
  .newsletter-form-container {
    width:90%;
  }
  .newsletter-heading-styles {
    font-size:{{ section.settings.heading-size }}px;
    color:{{section.settings.heading-color}};
    font-weight:{{section.settings.heading-weight}};
    font-style:{{section.settings.heading-style}};
    margin-bottom:20px;
  }
  .newsletter-btn-styles {
    font-size:{{ section.settings.btn-text-size }}px;
    color:{{section.settings.btn-text-color}};
    background-color:{{section.settings.btn-color}};
    font-weight:{{section.settings.btn-text-weight}};
    font-style:{{section.settings.btn-text-style}};
  }
  .newsletter-extra-info-styles {
    font-size:{{ section.settings.extra-info-size }}px;
    color:{{section.settings.extra-info-color}};
    font-weight:{{section.settings.extra-info-weight}};
    font-style:{{section.settings.extra-info-style}};
    margin-top:16px;
    text-transform:uppercase;
    width:100%;
  }
  @media (min-width: 600px) {
    .newsletter-container{
      height :{{section.settings.image-height}}px;
      margin-inline:{{settings.uniform-mx-lg}}px;
    }
    .newsletter-styles{
      margin-inline:{{ section.settings.mx }}%;
    }
    .newsletter-form-container {
      width:400px;
    }
  }
</style>

<section class="newsletter-styles">
  <section class="tracking-widest">
    <h2 class="w-full inline-block uppercase newsletter-heading-styles">
      {{- section.settings.subscribe_form_heading -}}
    </h2>
    {%- render 'newsletter',
      buttonText: section.settings.subscribe_form_btn_text,
      extrainfo: section.settings['extra-info'],
      btnstyles: 'newsletter-btn-styles',
      extraInfoStyles: 'newsletter-extra-info-styles',
      formPos: section.settings['x-alignment']
    -%}
  </section>
</section>

