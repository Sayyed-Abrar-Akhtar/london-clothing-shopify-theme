<style>
   .register-title-{{- section.id -}} {
     font-weight: {{ section.settings.title_weight }};
     font-style:{{ section.settings.title_style }};
     font-size: {{ section.settings.title_size }}px;
     color: {{ section.settings.title_color }};
     line-height: 150%;
   }
  .register-heading-{{- section.id -}} {
     font-weight: {{ section.settings.heading_weight }};
     font-style:{{ section.settings.heading_style }};
     font-size: {{ section.settings.heading_size }}px;
     color: {{ section.settings.heading_color }};
     line-height: 250%;
   }
  .register-input-labels-{{- section.id -}} {
     font-weight: {{ section.settings.form_label_weight }};
     font-style:{{ section.settings.form_label_style }};
     font-size: {{ section.settings.form_label_size }}px;
     color: {{ section.settings.form_label_color }};
     line-height: 150%;
   }
   .form-label-{{- section.id -}} {
     font-weight: {{ section.settings.form_label_weight }};
     font-style:{{ section.settings.form_label_style }};
     font-size: {{ section.settings.form_label_size }}px;
     color: {{ section.settings.form_label_color }};
   }
   .register-btn-{{- section.id -}} {
      border: 1px solid {{section.settings.btn-bg-color}};
      font-weight: {{ section.settings.btn_text_weight }};
      font-size: {{ section.settings.btn_text_size }}px;
      font-style: {{ section.settings.btn_text_style }};
      color: {{ section.settings.btn-color }};
      background-color: {{section.settings.btn-bg-color}};
      border-radius:{{section.settings.btn-border-radius}}px;
      padding-inline:{{section.settings.btn_px}}px;
      padding-block:{{section.settings.btn_py}}px;
   }
   .register-btn-{{- section.id -}}:hover {
      color: {{ section.settings.btn-color-hover }};
      background-color: {{section.settings.btn-bg-color-hover}};
      border-color: {{ section.settings.btn-bg-color-hover }};
   }
   .already-account-{{- section.id -}} {
     font-weight: {{ section.settings.already_account_weight }};
     font-style:{{ section.settings.already_account_style }};
     font-size: {{ section.settings.already_account_size }}px;
     color: {{ section.settings.already_account_color }};
   }
   .signin-link-{{- section.id -}} {
     font-weight: {{ section.settings.sign_in_text_weight }};
     font-style:{{ section.settings.sign_in_text_style }};
     font-size: {{ section.settings.sign_in_text_size }}px;
     color: {{ section.settings.sign_in_text_color }};
   }
</style>
<div
  id="account_register_container"
  class="relative flex w-full sm:w-[90%] md:w-[90%] lg:w-[75%] mx-auto my-4 overflow-hidden"
>
  <div class="flex flex-col items-center sm:justify-center md:justify-start flex-auto min-w-0 bg-white z-1">
    <div class="md:flex md:items-center md:justify-center sm:w-auto md:h-full w-full md:w-[55%] px-8 bg-white">
      <div class="max-w-md w-full ">
        <div class="text-center">
          <h2 class="register-title-{{ section.id }} mt-6">
            {{ section.settings.title }}
          </h2>
          <p class="register-heading-{{ section.id }} mt-2 text-sm text-gray-500">
            {{ section.settings.heading }}
          </p>
        </div>
        <div class="flex flex-row justify-center items-center space-x-3"></div>

        <div class="mt-8 space-y-8">
          {% form 'create_customer', return_to: '/pages/register-successful/' %}
            <ul class="mb-4 text-red-500" style="font-size:9px;letter-spacing:0.5px;font-weight:700;">
              {% for error in form.errors %}
                <li>
                  {% if error == 'form' %}
                    {{ form.errors.messages[error] }}
                  {% else %}
                    {{ form.errors.translated_fields[error] }} - {{ form.errors.messages[error] }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
            <div class="my-4 content-center">
              <label class="form-label-{{ section.id }} tracking-wide">
                {{- section.settings.fname_label }}
              </label>
              <input
                class=" w-full py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="text"
                name="customer[first_name]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif -%}
                placeholder="{{- section.settings.fname_placeholder -}}"
              >
            </div>
            <div class="my-4 content-center">
              <label class="form-label-{{ section.id }} tracking-wide">
                {{- section.settings.lname_label }}
              </label>
              <input
                class=" w-full py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="text"
                name="customer[last_name]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif -%}
                placeholder="{{- section.settings.lname_placeholder -}}"
              >
            </div>
            <div class="my-4 content-center">
              <label class="form-label-{{ section.id }} tracking-wide">
                {{- section.settings.email_label }}
              </label>
              <input
                class=" w-full py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif -%}
                placeholder="{{- section.settings.email_placeholder -}}"
              >
            </div>
            <div class="my-4 content-center">
              <label class="form-label-{{ section.id }} tracking-wide">
                {{ section.settings.password_label }}
              </label>
              <input
                class="w-full content-center py-2 border-b border-gray-300 focus:outline-none focus:border-indigo-500"
                type="password"
                value=""
                name="customer[password]"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{- section.settings.password_placeholder -}}"
              >
            </div>
            <div class="my-4 mt-8 flex justify-center items-center">
              <button
                type="submit"
                class="register-btn-{{ section.id }} flex justify-center tracking-wide cursor-pointer uppercase"
              >
                {{ section.settings.btn_text }}
              </button>
            </div>
          {%- endform -%}

          <p class="already-account-{{ section.id }} flex flex-col items-center justify-center mt-10 text-center gap-4">
            <span>{{ section.settings.already_account }}</span>
            <a
              href="{{ routes.account_login_url }}"
              class="signin-link-{{ section.id }} no-underline hover:underline cursor-pointer"
            >
              {{- section.settings.sign_in_text -}}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  
  
  const forgotPassword = () => {

    location.includes('#recover')? null : location.assign(`${location.href}#recover`)
    const recoverContainer = document.getElementById("recover_password_container")
    const loginContainer = document.getElementById("account_login_container")
    
    recoverContainer.classList.remove('hidden')
    loginContainer.classList.add('hidden')
    
  }
</script>

