{{ 'component-richtext.css' | asset_url | stylesheet_tag }}

<style>
  .rich-content-page {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .rich-content-page__inner {
    width: 100%;
  }

  .rich-content-page__header {
    margin-bottom: 40px;
    text-align: center;
  }

  .rich-content-page__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .rich-content-page__content {
    width: 100%;
  }

  /* Preserve all content styles */
  .rich-content-page__content * {
    max-width: 100%;
  }

  .rich-content-page__content img {
    height: auto;
    max-width: 100%;
  }

  .rich-content-page__content iframe,
  .rich-content-page__content video {
    width: 100%;
    max-width: 100%;
  }

  .rich-content-page__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }

  .rich-content-page__content table td,
  .rich-content-page__content table th {
    border: 1px solid #ddd;
    padding: 10px;
  }

  .rich-content-page__content ul,
  .rich-content-page__content ol {
    padding-left: 20px;
    margin: 15px 0;
  }

  .rich-content-page__content li {
    margin-bottom: 5px;
  }

  .rich-content-page__content blockquote {
    border-left: 4px solid #ddd;
    padding-left: 20px;
    margin: 20px 0;
    font-style: italic;
  }

  .rich-content-page__content pre {
    background: #f5f5f5;
    padding: 15px;
    border-radius: 4px;
    overflow-x: auto;
    margin: 20px 0;
  }

  .rich-content-page__content code {
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .rich-content-page {
      padding: 40px 15px;
    }

    .rich-content-page__header {
      margin-bottom: 30px;
    }
  }
</style>

<div class="rich-content-page">
  <div class="rich-content-page__inner">
    <header class="rich-content-page__header">
      <h1 class="rich-content-page__title">{{ page.title }}</h1>
      {% comment %}

        {% if page.published_at %}
          <div class="rich-content-page__meta">
            <time datetime="{{ page.published_at | date: '%Y-%m-%d' }}">
              {{ page.published_at | date: "%B %d, %Y" }}
            </time>
          </div>
        {% endif %}
      {% endcomment %}
    </header>

    <div class="rich-content-page__content rte">
      {{ page.content }}
    </div>
  </div>
</div>
