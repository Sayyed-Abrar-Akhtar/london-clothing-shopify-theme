[
  {
    "name": "theme_info",
    "theme_name": "SYD 2.0",
    "theme_version": "1.1.0",
    "theme_author": "Sayyed Abrar Akhtar",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "uniform-mx-sm",
        "label": "Uniform inline margin - Mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 5,
        "unit": "px",
        "info": "Standard horizontal margin for sections mobile view."
      },
      {
        "type": "range",
        "id": "uniform-mx-lg",
        "label": "Uniform inline margin - Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 25,
        "unit": "px",
        "info": "Standard horizontal margin for sections larger view."
      },
      {
        "type": "range",
        "id": "uniform-px-sm",
        "label": "Uniform inline Padding - Mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 10,
        "unit": "px",
        "info": "Standard horizontal gap for sections mobile view."
      },
      {
        "type": "range",
        "id": "uniform-px-lg",
        "label": "Uniform inline Padding - Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 25,
        "unit": "px",
        "info": "Standard horizontal gap for sections larger view."
      }
    ]
  },
  {
    "name": "Country",
    "settings": [
      {
        "type": "text",
        "label": "Local country code",
        "id": "local_country_code",
        "default": "NP",
        "info": "Must be all caps"
      },
      {
        "type": "number",
        "label": "Local country order limit",
        "id": "local_country_order_limit",
        "default": 20
      },
      {
        "type": "number",
        "label": "Local country shipping limit",
        "id": "local_country_shipping_limit",
        "default": 5
      }
    ]
  },
  {
    "name": "discount badge",
    "settings": [
      {
        "type": "checkbox",
        "label": "Show Discount",
        "id": "show_discount_badge",
        "default": false,
        "info": "Note: To show discount badge on product grids select or leave unselected"
      }
    ]
  },
  {
    "name": "default collection",
    "settings": [
      {
        "type": "text",
        "label": "Error cart item text",
        "id": "error_cart_item_text",
        "default": "Please add item to your cart."
      },
      {
        "type": "text",
        "label": "Btn text",
        "id": "redirect_btn_text",
        "default": "Shop now"
      },
      {
        "type": "text",
        "label": "Btn url",
        "id": "redirect_btn_url",
        "default": "/collections/all"
      }
    ]
  },
